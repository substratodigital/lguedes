---
/**
 * Ícone Lucide (line/stroke, uma cor) renderizado como SVG inline no build.
 * Zero JS no navegador. Uso: <Icon name="ArrowRight" size={16} />
 */
import * as icons from 'lucide-static';

interface Props {
  name: keyof typeof icons;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 16, stroke = 1.5, class: cls = '' } = Astro.props;
const raw = (icons as Record<string, string>)[name as string] ?? '';
const svg = raw
  .replace(/width="\d+"/, `width="${size}"`)
  .replace(/height="\d+"/, `height="${size}"`)
  .replace(/stroke-width="[\d.]+"/, `stroke-width="${stroke}"`)
  .replace('<svg', `<svg aria-hidden="true" focusable="false" class="icon ${cls}"`);
---
<Fragment set:html={svg} />
