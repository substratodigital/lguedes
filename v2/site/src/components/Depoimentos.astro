---
import { type Lang, useT } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="depoimentos" class="section depoimentos">
  <div class="container">
    <div class="dep__header" data-reveal>
      <span class="eyebrow">{t.depoimentos.label}</span>
      <div class="dep__title-row">
        <h2 class="h2">{t.depoimentos.h2}</h2>
        <div class="dep__nav">
          <button type="button" class="dep__btn" id="dep-prev" aria-label="Anterior">
            <Icon name="ArrowLeft" size={18} />
          </button>
          <button type="button" class="dep__btn" id="dep-next" aria-label="Próximo">
            <Icon name="ArrowRight" size={18} />
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="dep__viewport" id="dep-viewport">
    <div class="dep__track" id="dep-track">
      {t.depoimentos.items.map((item: any) => (
        <article class="dep-card">
          <div class="dep-card__stars" aria-label="5 estrelas">
            {[0, 1, 2, 3, 4].map(() => <Icon name="Star" size={13} stroke={1.5} class="star" />)}
          </div>
          <p class="dep-card__quote">"{item.quote}"</p>
          <a href={item.link || '#'} target="_blank" rel="noopener noreferrer" class="dep-card__author">
            <div>
              <p class="dep-card__name">{item.author}</p>
              {item.role && <p class="dep-card__role">{item.role}</p>}
            </div>
            <Icon name="Linkedin" size={16} />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .depoimentos { background: var(--bg-soft); border-block: 1px solid var(--line); overflow: hidden; }
  .dep__header { margin-bottom: 3rem; }
  .dep__title-row { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }

  .dep__nav { display: flex; gap: .5rem; }
  .dep__btn {
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    display: grid; place-items: center;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-2);
    transition: color .2s, border-color .2s, background-color .2s, opacity .2s, transform .3s var(--ease-out);
  }
  .dep__btn:hover:not(:disabled) { color: var(--primary); border-color: hsl(243 75% 59% / .4); background: var(--primary-soft); }
  .dep__btn:active:not(:disabled) { transform: scale(.94); }
  .dep__btn:disabled { opacity: .35; cursor: default; }

  .dep__viewport {
    overflow: hidden; touch-action: pan-y;
    padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    cursor: grab;
  }
  .dep__viewport.is-dragging { cursor: grabbing; }
  .dep__track { display: flex; gap: 1.5rem; will-change: transform; }

  .dep-card {
    flex: 0 0 clamp(290px, 82vw, 400px);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 2rem; display: flex; flex-direction: column;
    user-select: none;
  }
  .dep-card__stars { display: flex; gap: 3px; color: var(--primary); margin-bottom: 1.5rem; }
  .dep-card__stars :global(.star) { fill: currentColor; }
  .dep-card__quote {
    font-family: Georgia, 'Times New Roman', serif; font-style: italic;
    font-size: 1.05rem; line-height: 1.65; color: var(--ink-2);
    flex-grow: 1; margin-bottom: 2rem;
  }
  .dep-card__author {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--ink-3);
  }
  .dep-card__name { font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); transition: color .2s; }
  .dep-card__role { font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); margin-top: .2rem; }
  .dep-card__author:hover, .dep-card__author:hover .dep-card__name { color: var(--primary); }
</style>

<script>
  import { gsap } from 'gsap';

  const vp = document.getElementById('dep-viewport')!;
  const track = document.getElementById('dep-track')!;
  const prev = document.getElementById('dep-prev') as HTMLButtonElement;
  const next = document.getElementById('dep-next') as HTMLButtonElement;
  const cards = Array.from(track.children) as HTMLElement[];

  let index = 0;
  let x = 0;

  const maxX = () => Math.max(0, track.scrollWidth - (vp.clientWidth - parseFloat(getComputedStyle(vp).paddingLeft) * 2));
  const step = () => cards[0].offsetWidth + parseFloat(getComputedStyle(track).columnGap || '24');

  function update(animate = true) {
    x = Math.min(index * step(), maxX());
    gsap.to(track, { x: -x, duration: animate ? 0.7 : 0, ease: 'power3.out', overwrite: true });
    prev.disabled = index <= 0;
    next.disabled = x >= maxX() - 1;
  }

  prev.addEventListener('click', () => { index = Math.max(0, index - 1); update(); });
  next.addEventListener('click', () => { if (x < maxX() - 1) { index++; update(); } });

  // Arraste (mouse/touch)
  let sx = 0, sy = 0, base = 0, drag = false, locked: boolean | null = null;
  vp.addEventListener('pointerdown', (e) => { drag = true; locked = null; sx = e.clientX; sy = e.clientY; base = x; });
  window.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (locked === null && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) locked = Math.abs(dx) > Math.abs(dy);
    if (!locked) return;
    vp.classList.add('is-dragging');
    const nx = Math.min(Math.max(base - dx, -40), maxX() + 40);
    gsap.set(track, { x: -nx });
  }, { passive: true });
  window.addEventListener('pointerup', (e) => {
    if (!drag) return;
    drag = false; vp.classList.remove('is-dragging');
    if (locked) {
      const dx = e.clientX - sx;
      index = Math.round(Math.min(Math.max(base - dx, 0), maxX()) / step());
    }
    update();
  });

  addEventListener('resize', () => update(false));
  update(false);

  // Entrada escalonada
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set(cards, { autoAlpha: 0, y: 24 });
    new IntersectionObserver(([e], o) => {
      if (!e.isIntersecting) return; o.disconnect();
      gsap.to(cards, { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'power3.out' });
    }, { threshold: 0.15 }).observe(vp);
  }
</script>
