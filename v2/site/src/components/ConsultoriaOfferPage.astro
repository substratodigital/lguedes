---
import BaseLayout from '../layouts/Base.astro';
import Nav from './Nav.astro';
import ContatoFooter from './ContatoFooter.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { type Lang, homePath } from '../i18n';
import { CONSULTORIA_DATA } from '../data/consultoria';

interface Props {
  lang: Lang;
  offerIndex: 0 | 1;
}

const { lang, offerIndex } = Astro.props;
const data = CONSULTORIA_DATA[lang];
const offer = data.offers[offerIndex];
const otherOffer = data.offers[offerIndex === 0 ? 1 : 0];

const ptOffer = CONSULTORIA_DATA.pt.offers[offerIndex];
const enOffer = CONSULTORIA_DATA.en.offers[offerIndex];
const altLangHref = {
  pt: ptOffer.href,
  en: enOffer.href,
};

const homeConsultoriaHref = `${homePath(lang).replace(/\/+$/, '') || ''}/#consultoria`;
---

<BaseLayout
  lang={lang}
  title={`${offer.title} — Luís Guedes | Consultoria`}
  description={offer.subtitle}
>
  <Nav lang={lang} altLangHref={altLangHref} />

  <main id="main" class="coffer" style={`--offer-accent: ${offer.accent}`}>
    <!-- ── OFFER HERO ── -->
    <section class="coffer-hero">
      <div class="coffer-hero__bg" aria-hidden="true"></div>
      <div class="container">
        <div class="coffer-hero__topbar" data-reveal>
          <a href={homeConsultoriaHref} class="coffer-back font-mono">
            <span aria-hidden="true">←</span>
            <span>{data.backHomeLabel}</span>
          </a>
          <span class="coffer-axis-pill font-mono">
            <span class="coffer-axis-dot"></span>
            {offer.axisLabel}
          </span>
        </div>

        <div class="coffer-hero__grid">
          <div class="coffer-hero__content" data-reveal>
            <h1 class="coffer-hero__title">{offer.title}</h1>
            <p class="coffer-hero__subtitle">{offer.subtitle}</p>
            <p class="coffer-hero__thesis">{offer.heroThesis}</p>

            <blockquote class="coffer-hero__quote">
              <p>“{offer.heroQuote}”</p>
              <footer class="font-mono">— Prof. Dr. Luís Guedes · FIA / FEA-USP</footer>
            </blockquote>

            <div class="coffer-hero__actions">
              <a href="#catalogo-produtos" class="btn">
                <span>{data.portfolioTitle}</span>
                <span aria-hidden="true">↓</span>
              </a>
              <a href="#contato" class="btn btn-outline" data-select-consultoria>
                <span>{data.talkToSpecialistLabel}</span>
              </a>
            </div>
          </div>

          <!-- Architectural Visual Asset for Hero -->
          <div class="coffer-hero__visual" data-reveal>
            <div class="coffer-blueprint">
              <div class="coffer-blueprint__head font-mono">
                <span>SYS.PORTFOLIO // EIXO {offer.num}</span>
                <span>{offer.products.length} {data.solutionsCountLabel.toUpperCase()}</span>
              </div>

              <div class="coffer-blueprint__stage">
                {offerIndex === 0 ? (
                  <svg viewBox="0 0 440 340" class="coffer-blueprint__svg" fill="none" aria-hidden="true">
                    <!-- Concentric & Layered Organizational Architecture -->
                    <circle cx="220" cy="170" r="132" stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="3 5" />
                    <circle cx="220" cy="170" r="92" stroke="currentColor" stroke-opacity="0.2" />
                    <circle cx="220" cy="170" r="48" stroke="currentColor" stroke-opacity="0.35" />
                    <line x1="48" y1="170" x2="392" y2="170" stroke="currentColor" stroke-opacity="0.14" stroke-dasharray="2 4" />
                    <line x1="220" y1="24" x2="220" y2="316" stroke="currentColor" stroke-opacity="0.14" stroke-dasharray="2 4" />
                    <!-- 3 Isometric Governance Planes -->
                    <polygon points="220,66 340,118 220,170 100,118" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1.25" />
                    <polygon points="220,118 340,170 220,222 100,170" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-width="1.5" />
                    <polygon points="220,170 340,222 220,274 100,222" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1.25" />
                    <!-- 8 Orbiting Product Nodes -->
                    <g class="coffer-blueprint__nodes">
                      <circle cx="220" cy="66" r="5" fill="var(--offer-accent)" />
                      <circle cx="340" cy="118" r="4.5" fill="var(--offer-accent)" />
                      <circle cx="340" cy="170" r="4.5" fill="var(--offer-accent)" />
                      <circle cx="340" cy="222" r="4.5" fill="var(--offer-accent)" />
                      <circle cx="220" cy="274" r="5" fill="var(--offer-accent)" />
                      <circle cx="100" cy="222" r="4.5" fill="var(--offer-accent)" />
                      <circle cx="100" cy="170" r="4.5" fill="var(--offer-accent)" />
                      <circle cx="100" cy="118" r="4.5" fill="var(--offer-accent)" />
                    </g>
                  </svg>
                ) : (
                  <svg viewBox="0 0 440 340" class="coffer-blueprint__svg" fill="none" aria-hidden="true">
                    <!-- Operational Efficiency & AI Signal Architecture -->
                    <g stroke="currentColor" stroke-opacity="0.12">
                      <line x1="40" y1="70" x2="400" y2="70" />
                      <line x1="40" y1="120" x2="400" y2="120" />
                      <line x1="40" y1="170" x2="400" y2="170" />
                      <line x1="40" y1="220" x2="400" y2="220" />
                      <line x1="40" y1="270" x2="400" y2="270" />
                    </g>
                    <!-- Rising Efficiency Curve -->
                    <path
                      d="M 48 252 C 115 245, 145 195, 205 175 C 265 155, 310 92, 392 74"
                      stroke="currentColor"
                      stroke-width="2.2"
                    />
                    <path
                      d="M 48 252 C 115 245, 145 195, 205 175 C 265 155, 310 92, 392 74 L 392 270 L 48 270 Z"
                      fill="currentColor"
                      fill-opacity="0.07"
                    />
                    <!-- AI Pattern Detection Bounding Boxes -->
                    <rect x="172" y="138" width="72" height="68" rx="6" stroke="currentColor" stroke-width="1.3" stroke-dasharray="4 4" fill="currentColor" fill-opacity="0.04" />
                    <rect x="296" y="58" width="76" height="64" rx="6" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.06" />
                    <!-- 7 Product Telemetry Checkpoints -->
                    <circle cx="68" cy="248" r="4.5" fill="var(--offer-accent)" />
                    <circle cx="122" cy="228" r="4.5" fill="var(--offer-accent)" />
                    <circle cx="168" cy="196" r="4.5" fill="var(--offer-accent)" />
                    <circle cx="208" cy="174" r="5.5" fill="var(--offer-accent)" />
                    <circle cx="262" cy="138" r="4.5" fill="var(--offer-accent)" />
                    <circle cx="334" cy="90" r="5.5" fill="var(--offer-accent)" />
                    <circle cx="392" cy="74" r="5" fill="var(--offer-accent)" />
                  </svg>
                )}
              </div>

              <!-- Mini Index of Products inside Blueprint -->
              <div class="coffer-blueprint__index">
                {offer.products.map((prod) => (
                  <a href={`#prod-${prod.id}`} class="coffer-blueprint__pill">
                    <span class="font-mono coffer-blueprint__num">{prod.num}</span>
                    <span>{prod.title}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Strip -->
        <dl class="coffer-stats" data-reveal>
          {offer.stats.map((st) => (
            <div class="coffer-stats__item">
              <dt class="coffer-stats__label font-mono">{st.label}</dt>
              <dd class="coffer-stats__value">{st.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ── METHODOLOGY / PILLARS ── -->
    <section class="section coffer-method">
      <div class="container">
        <header class="coffer-method__head" data-reveal>
          <div>
            <span class="eyebrow">{data.methodEyebrow}</span>
            <h2 class="h2 coffer-method__title">{data.methodTitle}</h2>
          </div>
          <p class="lead">{data.methodLead}</p>
        </header>

        <div class="coffer-pillars">
          {offer.pillars.map((pillar) => (
            <article class="coffer-pillar" data-reveal>
              <span class="coffer-pillar__num font-mono">{pillar.num}</span>
              <h3 class="coffer-pillar__title">{pillar.title}</h3>
              <p class="coffer-pillar__desc">{pillar.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── DETAILED SOLUTIONS BREAKDOWN ── -->
    <section class="section coffer-catalog" id="catalogo-produtos">
      <div class="container">
        <header class="coffer-catalog__head" data-reveal>
          <span class="eyebrow">{data.portfolioEyebrow}</span>
          <h2 class="h2 coffer-catalog__title">{data.portfolioTitle}</h2>
        </header>

        <div class="coffer-catalog__layout">
          <!-- Sticky Side Navigation Rail -->
          <aside class="coffer-rail" aria-label={data.railLabel}>
            <div class="coffer-rail__inner">
              <span class="coffer-rail__heading font-mono">{data.railLabel} ({offer.products.length})</span>
              <nav class="coffer-rail__nav">
                {offer.products.map((prod, idx) => (
                  <a
                    href={`#prod-${prod.id}`}
                    class:list={['coffer-rail__link', { 'is-active': idx === 0 }]}
                    data-rail-link={`prod-${prod.id}`}
                  >
                    <span class="coffer-rail__num font-mono">{prod.num}</span>
                    <span class="coffer-rail__text">{prod.title}</span>
                  </a>
                ))}
              </nav>
            </div>
          </aside>

          <!-- Product Cards Stack -->
          <div class="coffer-products">
            {offer.products.map((prod) => (
              <article
                class="pcard"
                id={`prod-${prod.id}`}
                data-prod-section={`prod-${prod.id}`}
                data-reveal
              >
                <div class="pcard__top">
                  <div class="pcard__intro">
                    <div class="pcard__badges">
                      <span class="pcard__num font-mono">{prod.num}</span>
                      <span class="pcard__tag font-mono">{prod.tag}</span>
                    </div>
                    <h3 class="pcard__title">{prod.title}</h3>
                    <p class="pcard__desc">{prod.desc}</p>
                  </div>

                  <!-- Bespoke Minimalist Schematic Diagram per Product -->
                  <div class="pcard__diagram" aria-hidden="true">
                    <div class="pcard__diagram-head font-mono">
                      <span>FIG.{prod.num}</span>
                      <span>{prod.diagram.toUpperCase()}</span>
                    </div>
                    <svg viewBox="0 0 240 140" class="pcard__svg" fill="none">
                      {prod.diagram === 'diagnostico' && (
                        <g>
                          <circle cx="120" cy="70" r="52" stroke="currentColor" stroke-opacity="0.2" stroke-dasharray="3 3" />
                          <circle cx="120" cy="70" r="32" stroke="currentColor" stroke-opacity="0.35" />
                          <polygon points="120,22 162,55 148,108 92,108 78,55" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-width="1.5" />
                          <line x1="120" y1="14" x2="120" y2="126" stroke="currentColor" stroke-opacity="0.2" />
                          <line x1="56" y1="70" x2="184" y2="70" stroke="currentColor" stroke-opacity="0.2" />
                          <circle cx="120" cy="22" r="3.5" fill="currentColor" />
                          <circle cx="162" cy="55" r="3.5" fill="currentColor" />
                          <circle cx="148" cy="108" r="3.5" fill="currentColor" />
                          <circle cx="92" cy="108" r="3.5" fill="currentColor" />
                          <circle cx="78" cy="55" r="3.5" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'planejamento' && (
                        <g>
                          <line x1="28" y1="108" x2="212" y2="108" stroke="currentColor" stroke-opacity="0.25" />
                          <path d="M 36 98 Q 95 92, 130 62 T 204 28" stroke="currentColor" stroke-width="1.8" />
                          <path d="M 36 98 Q 95 92, 130 62 T 204 28" stroke="currentColor" stroke-opacity="0.2" stroke-width="8" />
                          <circle cx="36" cy="98" r="4" fill="currentColor" />
                          <circle cx="96" cy="82" r="4" fill="currentColor" />
                          <circle cx="148" cy="52" r="4" fill="currentColor" />
                          <circle cx="204" cy="28" r="5" fill="currentColor" />
                          <rect x="176" y="16" width="38" height="24" rx="4" stroke="currentColor" stroke-opacity="0.4" stroke-dasharray="2 2" />
                        </g>
                      )}
                      {prod.diagram === 'estrutura' && (
                        <g>
                          <rect x="96" y="18" width="48" height="22" rx="4" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.08" />
                          <line x1="120" y1="40" x2="120" y2="62" stroke="currentColor" stroke-width="1.2" />
                          <line x1="56" y1="62" x2="184" y2="62" stroke="currentColor" stroke-width="1.2" />
                          <line x1="56" y1="62" x2="56" y2="82" stroke="currentColor" stroke-width="1.2" />
                          <line x1="120" y1="62" x2="120" y2="82" stroke="currentColor" stroke-width="1.2" />
                          <line x1="184" y1="62" x2="184" y2="82" stroke="currentColor" stroke-width="1.2" />
                          <rect x="34" y="82" width="44" height="24" rx="4" stroke="currentColor" stroke-width="1.3" />
                          <rect x="98" y="82" width="44" height="24" rx="4" stroke="currentColor" stroke-width="1.3" />
                          <rect x="162" y="82" width="44" height="24" rx="4" stroke="currentColor" stroke-width="1.3" />
                        </g>
                      )}
                      {prod.diagram === 'governanca' && (
                        <g>
                          <circle cx="96" cy="70" r="36" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.05" />
                          <circle cx="144" cy="70" r="36" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.05" />
                          <circle cx="120" cy="70" r="8" fill="currentColor" />
                          <line x1="120" y1="22" x2="120" y2="118" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="3 3" />
                        </g>
                      )}
                      {prod.diagram === 'macroprocessos' && (
                        <g>
                          <rect x="24" y="52" width="46" height="36" rx="5" stroke="currentColor" stroke-width="1.4" />
                          <rect x="97" y="52" width="46" height="36" rx="5" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.08" />
                          <rect x="170" y="52" width="46" height="36" rx="5" stroke="currentColor" stroke-width="1.4" />
                          <path d="M 70 70 H 97" stroke="currentColor" stroke-width="1.4" />
                          <path d="M 143 70 H 170" stroke="currentColor" stroke-width="1.4" />
                          <circle cx="83.5" cy="70" r="3" fill="currentColor" />
                          <circle cx="156.5" cy="70" r="3" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'maturidade' && (
                        <g>
                          <rect x="38" y="92" width="24" height="26" rx="2" stroke="currentColor" stroke-width="1.3" />
                          <rect x="74" y="76" width="24" height="42" rx="2" stroke="currentColor" stroke-width="1.3" />
                          <rect x="110" y="58" width="24" height="60" rx="2" stroke="currentColor" stroke-width="1.3" fill="currentColor" fill-opacity="0.07" />
                          <rect x="146" y="40" width="24" height="78" rx="2" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.12" />
                          <rect x="182" y="22" width="24" height="96" rx="2" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.18" />
                        </g>
                      )}
                      {prod.diagram === 'mudanca' && (
                        <g>
                          <path d="M 30 96 C 75 96, 85 44, 130 44 C 175 44, 185 82, 212 34" stroke="currentColor" stroke-width="1.8" />
                          <path d="M 30 44 C 75 44, 85 96, 130 96 C 175 96, 185 52, 212 96" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="3 3" stroke-width="1.3" />
                          <circle cx="105" cy="68" r="5" fill="currentColor" />
                          <circle cx="172" cy="60" r="4" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'lideranca' && (
                        <g>
                          <polygon points="120,20 190,112 50,112" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.05" />
                          <line x1="74" y1="80" x2="166" y2="80" stroke="currentColor" stroke-opacity="0.4" />
                          <line x1="97" y1="50" x2="143" y2="50" stroke="currentColor" stroke-opacity="0.4" />
                          <circle cx="120" cy="20" r="4.5" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'riscos' && (
                        <g>
                          <rect x="52" y="20" width="136" height="100" rx="6" stroke="currentColor" stroke-width="1.3" />
                          <line x1="97" y1="20" x2="97" y2="120" stroke="currentColor" stroke-opacity="0.25" />
                          <line x1="143" y1="20" x2="143" y2="120" stroke="currentColor" stroke-opacity="0.25" />
                          <line x1="52" y1="53" x2="188" y2="53" stroke="currentColor" stroke-opacity="0.25" />
                          <line x1="52" y1="86" x2="188" y2="86" stroke="currentColor" stroke-opacity="0.25" />
                          <rect x="143" y="20" width="45" height="33" fill="currentColor" fill-opacity="0.18" />
                          <circle cx="165" cy="36.5" r="5" fill="currentColor" />
                          <circle cx="120" cy="70" r="4" fill="currentColor" fill-opacity="0.6" />
                        </g>
                      )}
                      {prod.diagram === 'premiacao' && (
                        <g>
                          <polygon points="120,20 176,52 176,96 120,124 64,96 64,52" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.06" />
                          <circle cx="120" cy="72" r="22" stroke="currentColor" stroke-width="1.3" />
                          <circle cx="120" cy="72" r="5" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'processos' && (
                        <g>
                          <path d="M 32 42 H 156 C 176 42, 176 70, 156 70 H 84 C 64 70, 64 98, 84 98 H 208" stroke="currentColor" stroke-width="1.6" />
                          <circle cx="56" cy="42" r="4" fill="currentColor" />
                          <circle cx="120" cy="70" r="4.5" fill="currentColor" />
                          <circle cx="184" cy="98" r="4" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'insights' && (
                        <g>
                          <line x1="36" y1="70" x2="204" y2="70" stroke="currentColor" stroke-opacity="0.2" />
                          <path d="M 36 70 L 68 62 L 94 78 L 120 26 L 146 98 L 172 54 L 204 70" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                          <rect x="102" y="16" width="36" height="92" rx="4" stroke="currentColor" stroke-opacity="0.4" stroke-dasharray="3 3" fill="currentColor" fill-opacity="0.06" />
                          <circle cx="120" cy="26" r="4.5" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'contratos' && (
                        <g>
                          <rect x="64" y="18" width="88" height="104" rx="5" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.04" />
                          <line x1="82" y1="42" x2="134" y2="42" stroke="currentColor" stroke-width="1.3" />
                          <line x1="82" y1="62" x2="134" y2="62" stroke="currentColor" stroke-width="1.3" />
                          <line x1="82" y1="82" x2="116" y2="82" stroke="currentColor" stroke-width="1.3" />
                          <circle cx="156" cy="88" r="22" fill="var(--bg-elev)" stroke="currentColor" stroke-width="1.5" />
                          <path d="M 148 88 L 154 94 L 166 82" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </g>
                      )}
                      {prod.diagram === 'comunicacao' && (
                        <g>
                          <circle cx="72" cy="70" r="14" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.1" />
                          <path d="M 102 46 A 34 34 0 0 1 102 94" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                          <path d="M 122 32 A 54 54 0 0 1 122 108" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-opacity="0.65" />
                          <path d="M 142 20 A 74 74 0 0 1 142 120" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-opacity="0.35" />
                          <circle cx="182" cy="46" r="4" fill="currentColor" />
                          <circle cx="194" cy="70" r="4" fill="currentColor" />
                          <circle cx="182" cy="94" r="4" fill="currentColor" />
                        </g>
                      )}
                      {prod.diagram === 'carreira' && (
                        <g>
                          <circle cx="120" cy="70" r="46" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" />
                          <polygon points="120,30 132,64 166,70 132,76 120,110 108,76 74,70 108,64" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.08" />
                          <circle cx="120" cy="70" r="4" fill="currentColor" />
                        </g>
                      )}
                    </svg>
                  </div>
                </div>

                <!-- 3-Column Executive Breakdown -->
                <div class="pcard__details">
                  <div class="pcard__col">
                    <h4 class="pcard__col-label font-mono">{data.challengeLabel}</h4>
                    <p class="pcard__col-text">{prod.challenge}</p>
                  </div>

                  <div class="pcard__col">
                    <h4 class="pcard__col-label font-mono">{data.deliverablesLabel}</h4>
                    <ul class="pcard__list">
                      {prod.deliverables.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="pcard__col pcard__col--impact">
                    <h4 class="pcard__col-label font-mono">{data.impactLabel}</h4>
                    <p class="pcard__col-text">{prod.impact}</p>
                    <a
                      href="#contato"
                      class="pcard__action font-mono"
                      data-select-consultoria
                    >
                      <span>{data.talkToSpecialistLabel}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── CROSS-LINK TO THE OTHER CONSULTING OFFER ── -->
    <section class="section-sm coffer-next">
      <div class="container">
        <a
          href={otherOffer.href}
          class="coffer-next__card"
          style={`--next-accent: ${otherOffer.accent}`}
          data-reveal
        >
          <div class="coffer-next__content">
            <span class="eyebrow">{data.otherOfferEyebrow}</span>
            <h2 class="h3 coffer-next__title">{otherOffer.title}</h2>
            <p class="coffer-next__sub">{otherOffer.subtitle}</p>
          </div>
          <div class="coffer-next__cta font-mono">
            <span>{data.otherOfferCta}</span>
            <span class="coffer-next__arrow" aria-hidden="true">→</span>
          </div>
        </a>
      </div>
    </section>
  </main>

  <ContatoFooter lang={lang} />
  <WhatsAppButton />
</BaseLayout>

<style>
  .coffer {
    padding-top: var(--nav-h);
