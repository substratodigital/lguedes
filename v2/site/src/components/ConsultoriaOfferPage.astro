<script>
  // Active product rail highlight via IntersectionObserver
  const railLinks = document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]');
  const prodSections = document.querySelectorAll<HTMLElement>('[data-prod-section]');

  if (railLinks.length && prodSections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = (entry.target as HTMLElement).dataset.prodSection;
            railLinks.forEach((l) => {
              l.classList.toggle('is-active', l.dataset.railLink === id);
            });
          }
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: 0 }
    );
    prodSections.forEach((s) => io.observe(s));
  }

  // Pre-select "Consultoria" in contact form when clicking a solution CTA
  document.querySelectorAll<HTMLAnchorElement>('[data-select-consultoria]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#cf-form select[name="type"]');
      if (select) {
        select.value = 'Consultoria';
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });
</script>

