---
import { type Lang, useT, SITE } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const lattesUrl = (SITE as any).lattes || 'http://lattes.cnpq.br/3044172197355296';
---

<section id="trajetoria" class="section bio">
  <div class="container bio__container">
    <div data-reveal>
      <span class="eyebrow">{t.bio.label}</span>
      <h2 class="h2 bio__title">{t.bio.h2}</h2>

      <div class="bio__pills">
        {t.bio.pills.map((pill: string) => (
          <span class="bio__pill">{pill}</span>
        ))}
      </div>

      <blockquote class="bio__quote">
        <p>"{t.bio.quote}"</p>
      </blockquote>

      <div class="bio__text">
        <p>{t.bio.p}</p>
      </div>

      {t.bio.complexidadeText && (
        <div class="bio__complexity">
          <div class="bio__complexity-head">
            <span class="bio__complexity-icon">
              <Icon name="ShieldCheck" size={18} stroke={1.75} />
            </span>
            <h3 class="bio__complexity-title">{t.bio.complexidadeTitle}</h3>
          </div>
          <p class="bio__complexity-desc">{t.bio.complexidadeText}</p>
        </div>
      )}

      <div class="bio__action">
        <button type="button" class="bio__btn bio__btn--primary" id="open-bio-modal">
          <Icon name="User" size={16} stroke={2} />
          <span>{t.bio.miniBioBtn ?? 'Mini Bio'}</span>
        </button>

        <a
          href={lattesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bio__btn bio__btn--outline"
          id="bio-lattes-btn"
        >
          <span>{t.bio.lattesBtn ?? 'Currículo Lattes'}</span>
          <Icon name="ExternalLink" size={15} stroke={2} />
        </a>
      </div>
    </div>
  </div>

  <!-- Dialog Nativo HTML5: 0 bytes de JS externo, 100% acessível -->
  <dialog id="bio-modal" class="bio-dialog" aria-labelledby="bio-dialog-title">
    <div class="bio-dialog__box">
      <div class="bio-dialog__head">
        <div>
          <span class="bio-dialog__eyebrow font-mono">{t.bio.miniBioBtn ?? 'Mini Bio'}</span>
          <h3 id="bio-dialog-title" class="bio-dialog__title">Luís Guedes, PhD</h3>
        </div>
        <button type="button" class="bio-dialog__close" id="close-bio-modal" aria-label="Fechar modal">✕</button>
      </div>
      <div class="bio-dialog__body">
        {t.bio.fullBio.split('\n\n').map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </dialog>
</section>

<style>
  .bio {
    background: var(--bg);
  }
  .bio__container {
    max-width: 58rem;
  }
  .bio__title {
    max-width: 26ch;
    margin-bottom: 1.5rem;
  }
  .bio__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 2rem;
  }
  .bio__pill {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--ink-2);
    border: 1px solid var(--line);
    background: hsl(0 0% 100% / 0.75);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
  }
  .bio__quote {
    border-left: 3px solid var(--primary);
    padding-left: 1.5rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.65rem);
    color: var(--ink);
    line-height: 1.4;
    margin-bottom: 1.75rem;
  }
  .bio__text {
    font-size: var(--fs-lg);
    line-height: 1.68;
    color: var(--ink-2);
    margin-bottom: 1.75rem;
  }
  .bio__complexity {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.35rem 1.5rem;
    margin-bottom: 2.25rem;
  }
  .bio__complexity-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }
  .bio__complexity-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
    flex-shrink: 0;
  }
  .bio__complexity-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .bio__complexity-desc {
    font-size: 0.925rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  /* Pares de botões (Mini Bio + Currículo Lattes): mesmo tamanho e largura lado a lado */
  .bio__action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .bio__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 220px;
    height: 3.1rem;
    padding-inline: 1.4rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s var(--ease-out);
    cursor: pointer;
    flex-shrink: 0;
  }
  .bio__btn--primary {
    background: var(--primary);
    border: 1.5px solid var(--primary);
    color: #fff;
    box-shadow: var(--shadow-primary);
  }
  .bio__btn--primary:hover {
    background: var(--primary-600);
    border-color: var(--primary-600);
    transform: translateY(-2px);
  }
  .bio__btn--outline {
    background: transparent;
    border: 1.5px solid var(--primary);
    color: var(--primary);
  }
  .bio__btn--outline:hover {
    background: var(--primary-soft);
    border-color: var(--primary-600);
    color: var(--primary-600);
    transform: translateY(-2px);
  }

  @media (max-width: 520px) {
    .bio__action {
      flex-direction: column;
      align-items: stretch;
    }
    .bio__btn {
      width: 100%;
    }
  }

  /* HTML5 Dialog */
  .bio-dialog {
    margin: auto;
    border: 0;
    border-radius: var(--radius-lg);
    background: transparent;
    max-width: min(44rem, 92vw);
    max-height: 85vh;
    padding: 0;
    box-shadow: var(--shadow);
  }
  .bio-dialog::backdrop {
    background: hsl(240 18% 10% / 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .bio-dialog__box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    max-height: 85vh;
  }
  .bio-dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--line);
  }
  .bio-dialog__eyebrow {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--primary);
    margin-bottom: 0.15rem;
  }
  .bio-dialog__title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
  }
  .bio-dialog__close {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 1rem;
    transition: all 0.2s;
  }
  .bio-dialog__close:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }
  .bio-dialog__body {
    padding: 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--ink-2);
    line-height: 1.7;
    font-size: 0.95rem;
  }
</style>

<script>
  const modal = document.getElementById('bio-modal') as HTMLDialogElement;
  const openBtn = document.getElementById('open-bio-modal');
  const closeBtn = document.getElementById('close-bio-modal');

  if (modal && openBtn && closeBtn) {
    openBtn.addEventListener('click', () => modal.showModal());
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      const rect = modal.getBoundingClientRect();
      const inDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!inDialog) modal.close();
    });
  }
</script>
