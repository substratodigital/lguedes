---
import { type Lang, useT } from '../i18n';
import Icon from './Icon.astro';
import { getPublicacoesData } from '../lib/sanity';
import { TEXTOS_REVISTAS, LEITURAS_ATUAIS } from '../data/publicacoes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const pub = t.publicacoes;

const {
  artigos: ARTIGOS_PERIODICOS,
  congressos: CONGRESSOS,
  livros: LIVROS,
  capitulos: CAPITULOS,
  premios: PREMIOS,
  midia: MIDIA,
  artigosOpiniao: ARTIGOS_OPINIAO
} = await getPublicacoesData();

const TABS = [
  { id: 'cientificas', label: pub.tabs[0], icon: 'BookOpen' as const },
  { id: 'livros',      label: pub.tabs[1], icon: 'BookMarked' as const },
  { id: 'premios',     label: pub.tabs[2], icon: 'Award' as const },
  { id: 'midia',       label: pub.tabs[3], icon: 'Mic' as const },
  { id: 'academicas',  label: pub.tabs[4], icon: 'GraduationCap' as const },
  { id: 'opiniao',     label: pub.tabs[5], icon: 'Newspaper' as const },
  { id: 'leituras',    label: pub.tabs[6] ?? 'O que estou lendo', icon: 'Sparkles' as const },
];
---

<section id="publicacoes" class="section publicacoes" data-ver-mais={pub.verMais} data-ver-menos={pub.verMenos} data-acessar={pub.acessar} data-livro-label={pub.livroLabel} data-comprar-label={pub.comprarLabel}>
  <div class="container">
    <div class="publicacoes__header" data-reveal>
      <span class="eyebrow">{pub.label}</span>
      <h2 class="h2 publicacoes__title">{pub.h2}</h2>
    </div>

    <!-- Navegação de Abas -->
    <div class="pub-tabs hide-scrollbar" role="tablist" aria-label="Categorias de Conteúdo" data-reveal>
      {TABS.map((tab, idx) => (
        <button
          type="button"
          role="tab"
          class:list={['pub-tab-btn', { 'is-active': idx === 0 }]}
          id={`tab-btn-${tab.id}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          aria-controls={`tab-panel-${tab.id}`}
          data-tab-target={tab.id}
        >
          <Icon name={tab.icon} size={16} class="pub-tab-btn__icon" />
          <span class="pub-tab-btn__label">{tab.label}</span>
        </button>
      ))}
    </div>

    <!-- Painéis de Conteúdo -->
    <div class="pub-panels">
      <!-- 1. CIENTÍFICAS -->
      <div id="tab-panel-cientificas" role="tabpanel" class="pub-panel is-active" aria-labelledby="tab-btn-cientificas">
        <!-- Sub-tabs -->
        <div class="pub-subtabs">
          <button type="button" class="pub-subtab-btn is-active" data-subtab-target="artigos">
            {pub.subtabs[0]}
          </button>
          <button type="button" class="pub-subtab-btn" data-subtab-target="congressos">
            {pub.subtabs[1]}
          </button>
        </div>

        <!-- Sub-panel Artigos em Periódicos -->
        <div id="subpanel-artigos" class="pub-subpanel is-active">
          <div class="pub-grid" id="artigos-grid">
            {ARTIGOS_PERIODICOS.map((a, i) => (
              <div class:list={['pub-card', { 'is-hidden': i >= 6 }]} data-artigo-item data-item-title={a.titulo}>
                <div class="pub-card__meta">
                  <span class="pub-card__year font-mono">{a.ano}</span>
                  {a.url && (
                    <a href={a.url} target="_blank" rel="noopener noreferrer" class="pub-card__ext" aria-label={`Ler artigo ${a.titulo}`}>
                      <Icon name="ExternalLink" size={14} />
                    </a>
                  )}
                </div>
                <h4 class="pub-card__title">{a.titulo}</h4>
                <p class="pub-card__source font-mono">{a.periodico}</p>
              </div>
            ))}
          </div>
          {ARTIGOS_PERIODICOS.length > 6 && (
            <div class="pub-more">
              <button type="button" class="pub-more-btn" id="btn-toggle-artigos" data-expanded="false">
                <span class="pub-more-text">{pub.verMais} ({ARTIGOS_PERIODICOS.length - 6})</span>
                <span class="pub-more-arrow"><Icon name="ChevronDown" size={16} /></span>
              </button>
            </div>
          )}
        </div>

        <!-- Sub-panel Congressos e Conferências -->
        <div id="subpanel-congressos" class="pub-subpanel">
          <div class="pub-table-wrap">
            <table class="pub-table" id="congressos-table">
              <thead>
                <tr>
                  <th class="font-mono w-year">{pub.anoLabel}</th>
                  <th class="font-mono">{pub.tituloLabel}</th>
                  <th class="font-mono">{pub.eventoLabel}</th>
                </tr>
              </thead>
              <tbody>
                {CONGRESSOS.map((c, i) => (
                  <tr class:list={[{ 'is-hidden': i >= 8 }]} data-congresso-item data-item-title={c.titulo}>
                    <td class="font-mono">{c.ano}</td>
                    <td class="pub-table__title">
                      {c.url ? (
                        <a href={c.url} target="_blank" rel="noopener noreferrer" class="pub-table__link">
                          {c.titulo} <Icon name="ExternalLink" size={13} />
                        </a>
                      ) : (
                        c.titulo
                      )}
                    </td>
                    <td class="pub-table__event">{c.evento}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {CONGRESSOS.length > 8 && (
            <div class="pub-more">
              <button type="button" class="pub-more-btn" id="btn-toggle-congressos" data-expanded="false">
                <span class="pub-more-text">{pub.verMais} ({CONGRESSOS.length - 8})</span>
                <span class="pub-more-arrow"><Icon name="ChevronDown" size={16} /></span>
              </button>
            </div>
          )}
        </div>
      </div>

      <!-- 2. LIVROS & CAPÍTULOS -->
      <div id="tab-panel-livros" role="tabpanel" class="pub-panel" aria-labelledby="tab-btn-livros">
        <div class="pub-livros-section">
          <div class="books-grid" id="livros-grid">
            {LIVROS.map((l) => (
              <div class="featured-book" data-livro-item data-item-title={l.titulo}>
                <div class:list={['featured-book__cover', { 'has-img': Boolean(l.capaUrl) }]}>
                  {l.capaUrl ? (
                    <img src={l.capaUrl} alt={`Capa do livro ${l.titulo}`} class="featured-book__img" loading="lazy" />
                  ) : (
                    <div class="book-jacket">
                      <span class="book-jacket__spine" aria-hidden="true"></span>
                      <span class="book-jacket__year font-mono">{l.ano}</span>
                      <strong class="book-jacket__title">{l.titulo}</strong>
                      <span class="book-jacket__author font-mono">LUÍS GUEDES</span>
                    </div>
                  )}
                </div>
                <div class="featured-book__info">
                  <div class="pub-card__meta">
                    <span class="pub-card__badge">{pub.livroLabel}</span>
                    <span class="pub-card__year font-mono">{l.ano}</span>
                  </div>
                  <h3 class="featured-book__title">{l.titulo}</h3>
                  <p class="featured-book__publisher">{l.editora}</p>
                  {l.url && (
                    <a href={l.url} target="_blank" rel="noopener noreferrer" class="btn btn-sm" style="margin-top:0.9rem;">
                      {pub.comprarLabel} <Icon name="ExternalLink" size={14} />
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>

          <h3 class="pub-section-subtitle font-mono">{pub.capitulosLabel}</h3>
          <div class="pub-table-wrap">
            <table class="pub-table" id="capitulos-table">
              <thead>
                <tr>
                  <th class="font-mono w-year">{pub.anoLabel}</th>
                  <th class="font-mono">{pub.capituloLabel}</th>
                  <th class="font-mono">{pub.livroSrcLabel}</th>
                  <th class="font-mono">{pub.editoraLabel}</th>
                </tr>
              </thead>
              <tbody>
                {CAPITULOS.map((cap) => (
                  <tr data-capitulo-item data-item-title={cap.titulo}>
                    <td class="font-mono">{cap.ano}</td>
                    <td class="pub-table__title">
                      {cap.url ? (
                        <a href={cap.url} target="_blank" rel="noopener noreferrer" class="pub-table__link">
                          {cap.titulo} <Icon name="ExternalLink" size={13} />
                        </a>
                      ) : (
                        cap.titulo
                      )}
                    </td>
                    <td class="pub-table__event"><em>{cap.livro}</em></td>
                    <td class="pub-table__event">{cap.editora}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 3. PRÊMIOS -->
      <div id="tab-panel-premios" role="tabpanel" class="pub-panel" aria-labelledby="tab-btn-premios">
        <div class="pub-table-wrap">
          <table class="pub-table" id="premios-table">
            <thead>
              <tr>
                <th class="font-mono w-year">{pub.anoLabel}</th>
                <th class="font-mono">{pub.premioLabel}</th>
                <th class="font-mono">{pub.concedidoLabel}</th>
              </tr>
            </thead>
            <tbody>
              {PREMIOS.map((p, i) => (
                <tr class:list={[{ 'is-hidden': i >= 8 }]} data-premio-item data-item-title={p.premio}>
                  <td class="font-mono">{p.ano}</td>
                  <td class="pub-table__title">{p.premio}</td>
                  <td class="pub-table__event">{p.concedido}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {PREMIOS.length > 8 && (
          <div class="pub-more">
            <button type="button" class="pub-more-btn" id="btn-toggle-premios" data-expanded="false">
              <span class="pub-more-text">{pub.verMais} ({PREMIOS.length - 8})</span>
              <span class="pub-more-arrow"><Icon name="ChevronDown" size={16} /></span>
            </button>
          </div>
        )}
      </div>

      <!-- 4. NA MÍDIA -->
      <div id="tab-panel-midia" role="tabpanel" class="pub-panel" aria-labelledby="tab-btn-midia">
        <div class="pub-grid" id="midia-grid">
          {MIDIA.map((m, i) => (
            <div class:list={['pub-card', { 'is-hidden': i >= 9 }]} data-midia-item data-item-title={m.titulo}>
              <div class="pub-card__meta">
                <span class="pub-card__badge">{m.tipo}</span>
                <span class="pub-card__year font-mono">{m.ano}</span>
              </div>
              <h4 class="pub-card__title">{m.titulo}</h4>
              {m.url && (
                <a href={m.url} target="_blank" rel="noopener noreferrer" class="pub-card__link">
                  {pub.acessar} <Icon name="ExternalLink" size={12} />
                </a>
              )}
            </div>
          ))}
        </div>
        {MIDIA.length > 9 && (
          <div class="pub-more">
            <button type="button" class="pub-more-btn" id="btn-toggle-midia" data-expanded="false">
              <span class="pub-more-text">{pub.verMais} ({MIDIA.length - 9})</span>
              <span class="pub-more-arrow"><Icon name="ChevronDown" size={16} /></span>
            </button>
          </div>
        )}
      </div>

      <!-- 5. ATIVIDADES ACADÊMICAS -->
      <div id="tab-panel-academicas" role="tabpanel" class="pub-panel" aria-labelledby="tab-btn-academicas">
        {pub.academicasMetrics && (
          <div class="academic-metrics">
            {pub.academicasMetrics.map((m: { badge: string; title: string; desc: string }) => (
              <article class="academic-metric-card">
                <span class="academic-metric-card__badge font-mono">{m.badge}</span>
                <h4 class="academic-metric-card__title">{m.title}</h4>
                <p class="academic-metric-card__desc">{m.desc}</p>
              </article>
            ))}
          </div>
        )}
        <div class="academic-list">
          {pub.atividades.map((item: string) => (
            <div class="academic-item">
              <div class="academic-item__icon"><Icon name="GraduationCap" size={15} /></div>
              <p class="academic-item__text">{item}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 6. ARTIGOS DE OPINIÃO & REVISTAS -->
      <div id="tab-panel-opiniao" role="tabpanel" class="pub-panel" aria-labelledby="tab-btn-opiniao">
        <div class="pub-revistas-block">
          <p class="pub-opiniao-desc font-mono">{pub.revistasTitle ?? 'Colunas e Artigos em Revistas e Portais'}</p>
          <div class="pub-grid pub-grid--revistas">
            {TEXTOS_REVISTAS.map((r) => (
              <div class="pub-card">
                <div class="pub-card__meta">
                  <span class="pub-card__badge">{r.veiculo}</span>
                  <span class="pub-card__year font-mono">{r.ano}</span>
                </div>
                <h4 class="pub-card__title">{r.titulo}</h4>
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="pub-card__link">
                  {pub.acessar} <Icon name="ExternalLink" size={12} />
                </a>
              </div>
            ))}
          </div>
        </div>

        <p class="pub-opiniao-desc font-mono" style="margin-top: 2.5rem;">{pub.opiniaoSource}</p>
        <div class="pub-table-wrap">
          <table class="pub-table" id="opiniao-table">
            <thead>
              <tr>
                <th class="font-mono">{pub.tituloLabel}</th>
              </tr>
            </thead>
            <tbody>
              {ARTIGOS_OPINIAO.map((tit, i) => (
                <tr class:list={[{ 'is-hidden': i >= 12 }]} data-opiniao-item data-item-title={tit}>
                  <td class="pub-table__title">{tit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {ARTIGOS_OPINIAO.length > 12 && (
          <div class="pub-more">
            <button type="button" class="pub-more-btn" id="btn-toggle-opiniao" data-expanded="false">
              <span class="pub-more-text">{pub.verMais} ({ARTIGOS_OPINIAO.length - 12})</span>
              <span class="pub-more-arrow"><Icon name="ChevronDown" size={16} /></span>
            </button>
          </div>
        )}
      </div>

      <!-- 7. O QUE ESTOU LENDO -->
      <div id="tab-panel-leituras" role="tabpanel" class="pub-panel" aria-labelledby="tab-btn-leituras">
        <p class="pub-leituras-intro">{pub.leiturasIntro}</p>
        <div class="pub-grid">
          {LEITURAS_ATUAIS.map((item) => (
            <article class="pub-card pub-card--reading">
              <div class="pub-card__meta">
                <span class="pub-card__badge">{item.categoria}</span>
                <Icon name="BookOpen" size={15} class="pub-reading-icon" />
              </div>
              <h4 class="pub-card__title">{item.titulo}</h4>
              <p class="pub-reading-author font-mono">{item.autor}</p>
              <p class="pub-reading-note">{item.nota}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .publicacoes {
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
  }
  .publicacoes__header {
    margin-bottom: 2.5rem;
  }

  /* Abas principais */
  .pub-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .pub-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-2);
    border: 1px solid var(--line);
    background: var(--surface);
    white-space: nowrap;
    transition: all 0.2s var(--ease-out);
  }
  .pub-tab-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .pub-tab-btn.is-active {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  /* Sub-tabs */
  .pub-subtabs {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .pub-subtab-btn {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-3);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    transition: all 0.2s;
  }
  .pub-subtab-btn:hover {
    color: var(--ink);
  }
  .pub-subtab-btn.is-active {
    background: var(--primary-soft);
    color: var(--primary);
    border-color: hsl(243 75% 59% / 0.25);
  }

  /* Painéis */
  .pub-panel {
    display: none;
  }
  .pub-panel.is-active {
    display: block;
  }
  .pub-subpanel {
    display: none;
  }
  .pub-subpanel.is-active {
    display: block;
  }

  /* Grid de Cards */
  .pub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .pub-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, transform 0.2s;
  }
  .pub-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }
  .pub-card.is-hidden {
    display: none;
  }

  .pub-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pub-card__year {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    font-weight: 700;
  }
  .pub-card__ext {
    font-size: 1rem;
    color: var(--primary);
    font-weight: 700;
  }
  .pub-card__badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--bg-soft);
    color: var(--ink-2);
    border: 1px solid var(--line);
  }
  .pub-card__title {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
  }
  .pub-card__source {
    font-size: 0.775rem;
    color: var(--primary);
    margin-top: auto;
  }
  .pub-card__link {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--primary);
    margin-top: auto;
  }

  /* Tabelas */
  .pub-table-wrap {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow-x: auto;
  }
  .pub-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    text-align: left;
  }
  .pub-table th {
    padding: 1rem 1.25rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .pub-table td {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .pub-table tr:last-child td {
    border-bottom: none;
  }
  .pub-table tr.is-hidden {
    display: none;
  }
  .pub-table tr:hover td {
    background: hsl(240 20% 98%);
  }
  .w-year {
    width: 5.5rem;
  }
  .pub-table__title {
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
  }
  .pub-table__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    transition: color 0.2s;
  }
  .pub-table__link:hover {
    color: var(--primary);
  }
  .pub-table__event {
    color: var(--ink-2);
    font-size: 0.825rem;
    line-height: 1.4;
  }

  /* Livros Destaque (Editorial Covers) */
  .pub-livros-section {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }
  .featured-book {
    display: flex;
    gap: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 2rem;
    align-items: center;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, transform 0.2s;
  }
  .featured-book:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }
  .featured-book__cover {
    width: 132px;
    height: 184px;
    border-radius: 6px 10px 10px 6px;
    background: linear-gradient(145deg, #1e1b4b 0%, #312e81 48%, #4f46e5 100%);
    color: #fff;
    flex-shrink: 0;
    box-shadow:
      -4px 0 0 #111827,
      0 14px 28px -8px rgba(30, 27, 75, 0.35);
    position: relative;
    overflow: hidden;
    display: flex;
  }
  .featured-book__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book-jacket {
    padding: 1rem 0.9rem 0.9rem 1.15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .book-jacket__spine {
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.22);
  }
  .book-jacket__year {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    color: #c7d2fe;
  }
  .book-jacket__title {
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .book-jacket__author {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: #e0e7ff;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 0.45rem;
  }
  .featured-book__title {
    font-size: 1.28rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
    margin-block: 0.5rem 0.35rem;
  }
  .featured-book__publisher {
    color: var(--ink-2);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .pub-section-subtitle {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: -1.5rem;
  }

  /* Atividades Acadêmicas */
  .academic-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .academic-metric-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--primary);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .academic-metric-card__badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 0.45rem;
  }
  .academic-metric-card__title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .academic-metric-card__desc {
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.55;
  }
  .academic-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 56rem;
  }
  .academic-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1.35rem 1.75rem;
  }
  .academic-item__icon {
    color: var(--primary);
    font-size: 1.1rem;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid hsl(243 75% 59% / .3);
    display: grid;
    place-items: center;
  }
  .academic-item__text {
    font-size: 0.98rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  /* Artigos de Opinião & Leituras */
  .pub-opiniao-desc {
    color: var(--ink-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .pub-leituras-intro {
    font-size: 1rem;
    color: var(--ink-2);
    max-width: 54ch;
    margin-bottom: 1.75rem;
  }
  .pub-reading-author {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary);
  }
  .pub-reading-note {
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.55;
    margin-top: 0.25rem;
  }

  /* Botão Ver Mais */
  .pub-more {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .pub-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--primary);
    border: 1px solid hsl(243 75% 59% / 0.3);
    padding: 0.55rem 1.4rem;
    border-radius: var(--radius-pill);
    background: var(--surface);
    transition: all 0.2s;
  }
  .pub-more-btn:hover {
    background: var(--primary-soft);
    border-color: var(--primary);
  }

  @media (max-width: 640px) {
    .featured-book {
      flex-direction: column;
      align-items: flex-start;
    }
    .books-grid {
      grid-template-columns: 1fr;
    }
  }
  .pub-tab-btn :global(.pub-tab-btn__icon) { color: var(--ink-3); transition: color .2s; }
  .pub-tab-btn.is-active :global(.pub-tab-btn__icon) { color: #a5b4fc; }
  .pub-card__ext { display: inline-flex; color: var(--ink-3); transition: color .2s; }
  .pub-card:hover .pub-card__ext { color: var(--primary); }
  .pub-card__link, .featured-book a { display: inline-flex; align-items: center; gap: .35rem; }
  .pub-more-arrow { display: inline-flex; transition: transform .35s var(--ease-out); }
  .pub-more-btn[data-expanded="true"] .pub-more-arrow { transform: rotate(180deg); }
</style>

<script>
  import { gsap } from 'gsap';
  const reducedPub = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pubSection = document.getElementById('publicacoes');
  const labelMais = pubSection?.getAttribute('data-ver-mais') || 'Ver mais';
  const labelMenos = pubSection?.getAttribute('data-ver-menos') || 'Ver menos';
  const labelAcessar = pubSection?.getAttribute('data-acessar') || 'Acessar';
  const labelLivro = pubSection?.getAttribute('data-livro-label') || 'Livro Publicado';
  const labelComprar = pubSection?.getAttribute('data-comprar-label') || 'Acessar obra';

  function animateIn(root: Element | null, onlyEls?: Element[]) {
    if (!root || reducedPub) return;
    const els = onlyEls ?? Array.from(root.querySelectorAll(
      '.pub-subtabs, .pub-card:not(.is-hidden), .pub-table-wrap, .pub-table tbody tr:not(.is-hidden), .featured-book, .pub-section-subtitle, .academic-metric-card, .academic-item, .pub-opiniao-desc, .pub-more'
    )).filter((el) => (el as HTMLElement).offsetParent !== null);
    gsap.fromTo(els, { autoAlpha: 0, y: 16 }, {
      autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out',
      stagger: { each: 0.035, from: 'start' }, overwrite: true, clearProps: 'transform',
    });
  }

  if (pubSection && !reducedPub) {
    new IntersectionObserver(([e], o) => {
      if (!e.isIntersecting) return; o.disconnect();
      animateIn(document.querySelector('.pub-panel.is-active'));
    }, { threshold: 0.1 }).observe(pubSection.querySelector('.pub-panels')!);
  }

  // Controle de abas principais
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-tab-target]');
  const panels = document.querySelectorAll<HTMLElement>('.pub-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab-target');
      tabBtns.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      panels.forEach((p) => p.classList.remove('is-active'));

      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      const panel = document.getElementById(`tab-panel-${target}`);
      panel?.classList.add('is-active');
      animateIn(panel);
    });
  });

  // Controle de sub-abas (Artigos / Congressos)
  const subBtns = document.querySelectorAll<HTMLButtonElement>('[data-subtab-target]');
  const subpanels = document.querySelectorAll<HTMLElement>('.pub-subpanel');

  subBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-subtab-target');
      subBtns.forEach((b) => b.classList.remove('is-active'));
      subpanels.forEach((p) => p.classList.remove('is-active'));

      btn.classList.add('is-active');
      const sp = document.getElementById(`subpanel-${target}`);
      sp?.classList.add('is-active');
      animateIn(sp);
    });
  });

  // Ver mais genérico
  function setupExpandToggle(btnId: string, itemSelector: string, baseCount: number) {
    const btn = document.getElementById(btnId);
    if (!btn) return;

    btn.addEventListener('click', () => {
      const items = document.querySelectorAll<HTMLElement>(itemSelector);
      const isExpanded = btn.getAttribute('data-expanded') === 'true';
      const nextExpanded = !isExpanded;
      btn.setAttribute('data-expanded', String(nextExpanded));

      const revealed: Element[] = [];
      items.forEach((item, idx) => {
        if (idx >= baseCount) {
          item.classList.toggle('is-hidden', !nextExpanded);
          if (nextExpanded) revealed.push(item);
        }
      });
      if (nextExpanded) animateIn(btn.closest('.pub-panel, .pub-subpanel'), revealed);

      const textEl = btn.querySelector('.pub-more-text');
      if (textEl) {
        textEl.textContent = nextExpanded ? labelMenos : `${labelMais} (${items.length - baseCount})`;
      }
    });
  }

  setupExpandToggle('btn-toggle-artigos', '[data-artigo-item]', 6);
  setupExpandToggle('btn-toggle-congressos', '[data-congresso-item]', 8);
  setupExpandToggle('btn-toggle-premios', '[data-premio-item]', 8);
  setupExpandToggle('btn-toggle-midia', '[data-midia-item]', 9);
  setupExpandToggle('btn-toggle-opiniao', '[data-opiniao-item]', 12);

  // Sincronização em tempo real com o Sanity Studio (para refletir novos livros/artigos publicados sem precisar de rebuild)
  const SANITY_QUERY = `{
    "artigos": *[_type == "artigoPeriodico"] | order(ano desc) { ano, titulo, periodico, url },
    "livros": *[_type == "livro"] | order(ano desc) { ano, titulo, editora, url, "capaUrl": capa.asset->url },
    "congressos": *[_type == "congresso"] | order(ano desc) { ano, titulo, evento, url },
    "capitulos": *[_type == "capitulo"] | order(ano desc) { ano, titulo, livro, editora, url },
    "midia": *[_type == "midia"] | order(ano desc) { ano, titulo, tipo, url },
    "artigosOpiniao": *[_type == "artigoOpiniao"] | order(ordem asc) { titulo }
  }`;
  const SANITY_URL = `https://84rosfy5.api.sanity.io/v2024-01-01/data/query/production?query=${encodeURIComponent(SANITY_QUERY)}`;

  const norm = (s: string) => (s || '').trim().toLowerCase();
  const extIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>`;

  async function refreshPublicacoesFromSanity() {
    try {
      const res = await fetch(SANITY_URL, { cache: 'no-store' });
      if (!res.ok) return;
      const payload = await res.json();
      const result = payload?.result;
      if (!result) return;

      // 1. Livros Publicados
      const livrosGrid = document.getElementById('livros-grid');
      if (livrosGrid && Array.isArray(result.livros)) {
        const existingTitles = new Set(
          Array.from(livrosGrid.querySelectorAll<HTMLElement>('[data-livro-item]'))
            .map((el) => norm(el.dataset.itemTitle || ''))
        );
        result.livros.forEach((l: any) => {
          if (!l?.titulo || existingTitles.has(norm(l.titulo))) return;
          existingTitles.add(norm(l.titulo));
          const card = document.createElement('div');
          card.className = 'featured-book';
          card.setAttribute('data-livro-item', '');
          card.setAttribute('data-item-title', l.titulo);
          card.innerHTML = `
            <div class="featured-book__cover ${l.capaUrl ? 'has-img' : ''}">
              ${l.capaUrl
                ? `<img src="${l.capaUrl}" alt="Capa do livro ${l.titulo}" class="featured-book__img" loading="lazy" />`
                : `<div class="book-jacket">
                    <span class="book-jacket__spine" aria-hidden="true"></span>
                    <span class="book-jacket__year font-mono">${l.ano || ''}</span>
                    <strong class="book-jacket__title">${l.titulo}</strong>
                    <span class="book-jacket__author font-mono">LUÍS GUEDES</span>
                  </div>`
              }
            </div>
            <div class="featured-book__info">
              <div class="pub-card__meta">
                <span class="pub-card__badge">${labelLivro}</span>
                <span class="pub-card__year font-mono">${l.ano || ''}</span>
              </div>
              <h3 class="featured-book__title">${l.titulo}</h3>
              <p class="featured-book__publisher">${l.editora || ''}</p>
              ${l.url ? `<a href="${l.url}" target="_blank" rel="noopener noreferrer" class="btn btn-sm" style="margin-top:0.9rem;">${labelComprar} ${extIconSvg}</a>` : ''}
            </div>
          `;
          livrosGrid.prepend(card);
        });
      }

      // 2. Artigos em Periódicos
      const artigosGrid = document.getElementById('artigos-grid');
      if (artigosGrid && Array.isArray(result.artigos)) {
        const existingTitles = new Set(
          Array.from(artigosGrid.querySelectorAll<HTMLElement>('[data-artigo-item]'))
            .map((el) => norm(el.dataset.itemTitle || ''))
        );
        result.artigos.forEach((a: any) => {
          if (!a?.titulo || existingTitles.has(norm(a.titulo))) return;
          existingTitles.add(norm(a.titulo));
          const card = document.createElement('div');
          card.className = 'pub-card';
          card.setAttribute('data-artigo-item', '');
          card.setAttribute('data-item-title', a.titulo);
          card.innerHTML = `
            <div class="pub-card__meta">
              <span class="pub-card__year font-mono">${a.ano || ''}</span>
              ${a.url ? `<a href="${a.url}" target="_blank" rel="noopener noreferrer" class="pub-card__ext" aria-label="Ler artigo ${a.titulo}">${extIconSvg}</a>` : ''}
            </div>
            <h4 class="pub-card__title">${a.titulo}</h4>
            <p class="pub-card__source font-mono">${a.periodico || ''}</p>
          `;
          artigosGrid.prepend(card);
        });
      }

      // 3. Na Mídia
      const midiaGrid = document.getElementById('midia-grid');
      if (midiaGrid && Array.isArray(result.midia)) {
        const existingTitles = new Set(
          Array.from(midiaGrid.querySelectorAll<HTMLElement>('[data-midia-item]'))
            .map((el) => norm(el.dataset.itemTitle || ''))
        );
        result.midia.forEach((m: any) => {
          if (!m?.titulo || existingTitles.has(norm(m.titulo))) return;
          existingTitles.add(norm(m.titulo));
          const card = document.createElement('div');
          card.className = 'pub-card';
          card.setAttribute('data-midia-item', '');
          card.setAttribute('data-item-title', m.titulo);
          card.innerHTML = `
            <div class="pub-card__meta">
              <span class="pub-card__badge">${m.tipo || 'Mídia'}</span>
              <span class="pub-card__year font-mono">${m.ano || ''}</span>
            </div>
            <h4 class="pub-card__title">${m.titulo}</h4>
            ${m.url ? `<a href="${m.url}" target="_blank" rel="noopener noreferrer" class="pub-card__link">${labelAcessar} ${extIconSvg}</a>` : ''}
          `;
          midiaGrid.prepend(card);
        });
      }
    } catch {
      // Fallback estático mantido silenciosamente se offline
    }
  }

  refreshPublicacoesFromSanity();
</script>
