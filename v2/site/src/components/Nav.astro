---
import { type Lang, useT, SITE, homePath, LANGS } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<header class="nav" id="site-nav" data-nav>
  <div class="container nav__inner">
    <a href={homePath(lang)} class="nav__logo" id="nav-logo" aria-label="Guedes.AI — início">
      GUEDES<span>.</span>AI
    </a>

    <nav class="nav__links" aria-label="Principal">
      {t.nav.links.map((l) => (
        <a href={l.href} class="nav__link" id={`nav-link-${l.href.slice(1)}`}>{l.name}</a>
      ))}
    </nav>

    <div class="nav__actions">
      <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn" id="nav-linkedin">
        <Icon name="Linkedin" size={16} stroke={1.5} />
      </a>

      <div class="nav__lang" role="group" aria-label="Idioma">
        {LANGS.map((l) => (
          <a href={homePath(l)} class:list={['nav__lang-item', { 'is-active': l === lang }]} hreflang={l} id={`nav-lang-${l}`} aria-current={l === lang ? 'true' : undefined}>{l}</a>
        ))}
      </div>

      <a href="#contato" class="btn btn-sm nav__cta" id="nav-cta">{t.nav.cta}</a>

      <button class="nav__burger" id="nav-burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mmenu" id="mobile-menu" hidden>
  <nav class="mmenu__list" aria-label="Menu mobile">
    {t.nav.links.map((l, i) => (
      <a href={l.href} class="mmenu__item" data-mmenu-item>
        <span class="mmenu__num font-mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="mmenu__label">{l.name}</span>
        <span class="mmenu__arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>
  <div class="mmenu__foot" data-mmenu-item>
    <a href="#contato" class="btn" style="width:100%">{t.nav.cta}</a>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    height: var(--nav-h);
    display: flex; align-items: center;
    transition: background-color .35s, box-shadow .35s, height .35s var(--ease-out);
  }
  .nav.is-scrolled {
    height: 3.75rem;
    background: hsl(240 20% 99% / 0.82);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .nav__logo {
    font-weight: 700; letter-spacing: -0.02em; font-size: 0.95rem;
    position: relative; z-index: 110;
    transition: color .2s;
  }
  .nav__logo span { color: var(--primary); }
  .nav__logo:hover { color: var(--primary); }

  .nav__links { display: none; gap: 2rem; }
  .nav__link {
    position: relative; font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2);
    transition: color .2s;
  }
  .nav__link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px;
    background: var(--primary); transform: scaleX(0); transform-origin: right;
    transition: transform .4s var(--ease-out);
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }

  .nav__actions { display: flex; align-items: center; gap: 0.5rem; position: relative; z-index: 110; }

  .nav__lang {
    display: inline-flex; height: 2.4rem; padding: 3px; gap: 2px;
    border: 1px solid var(--line); border-radius: var(--radius-pill);
  }
  .nav__lang-item {
    display: grid; place-items: center; min-width: 2.1rem; padding-inline: .5rem;
    border-radius: var(--radius-pill);
    font-size: 0.7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-3); transition: color .2s, background-color .2s;
  }
  .nav__lang-item:hover { color: var(--ink); }
  .nav__lang-item.is-active { background: var(--ink); color: #fff; }

  .nav__cta { display: none; }

  .nav__burger {
    width: 2.4rem; height: 2.4rem; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 5px;
  }
  .nav__burger span {
    display: block; width: 20px; height: 1.5px; background: var(--ink);
    transition: transform .3s var(--ease-out), opacity .2s;
  }
  .nav__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  @media (min-width: 1024px) {
    .nav__links { display: flex; }
    .nav__cta { display: inline-flex; }
    .nav__burger { display: none; }
  }
  @media (max-width: 420px) { .nav__actions > .icon-btn { display: none; } }

  /* Mobile menu */
  .mmenu {
    position: fixed; inset: 0; z-index: 100;
    background: var(--bg);
    display: flex; flex-direction: column;
    padding-top: var(--nav-h);
  }
  .mmenu[hidden] { display: none; }
  .mmenu__list { flex: 1; display: flex; flex-direction: column; overflow-y: auto; border-top: 1px solid var(--line); }
  .mmenu__item {
    display: flex; align-items: center; gap: 1.25rem;
    padding: 1.5rem var(--gutter); border-bottom: 1px solid var(--line);
  }
  .mmenu__num { font-size: var(--fs-xs); color: var(--ink-3); width: 1.5rem; }
  .mmenu__label { font-size: 2.1rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
  .mmenu__arrow { margin-left: auto; color: var(--ink-3); font-family: var(--font-mono); transition: transform .3s var(--ease-out), color .2s; }
  .mmenu__item:hover .mmenu__label, .mmenu__item:hover .mmenu__arrow { color: var(--primary); }
  .mmenu__item:hover .mmenu__arrow { transform: translateX(4px); }
  .mmenu__foot { padding: 1.5rem var(--gutter) 2rem; border-top: 1px solid var(--line); }
</style>

<script>
  import { gsap } from 'gsap';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = document.getElementById('nav-burger') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;

  // Estado "scrolled" via IntersectionObserver num sentinela (sem listener de scroll)
  const sentinel = document.createElement('div');
  sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none';
  document.body.prepend(sentinel);
  new IntersectionObserver(([e]) => nav.classList.toggle('is-scrolled', !e.isIntersecting)).observe(sentinel);

  let open = false;
  function setMenu(next: boolean) {
    open = next;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      menu.hidden = false;
      gsap.fromTo(menu, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.25 });
      gsap.fromTo(menu.querySelectorAll('[data-mmenu-item]'),
        { x: -28, autoAlpha: 0 },
        { x: 0, autoAlpha: 1, duration: 0.45, stagger: 0.06, ease: 'power3.out', delay: 0.05 });
    } else {
      gsap.to(menu, { autoAlpha: 0, duration: 0.2, onComplete: () => { menu.hidden = true; } });
    }
  }
  burger.addEventListener('click', () => setMenu(!open));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) setMenu(false); });
</script>
