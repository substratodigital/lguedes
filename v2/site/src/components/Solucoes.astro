---
import { type Lang, useT } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="solucoes" class="section solucoes">
  <div class="container">
    <div class="solucoes__header" data-reveal>
      <span class="eyebrow">{t.solucoes.label}</span>
      <h2 class="h2 solucoes__title">{t.solucoes.h2}</h2>
    </div>

    <div class="solucoes__grid">
      {t.solucoes.items.map((item: any, i: number) => (
        <div class="solucao-card" data-reveal data-delay={(i * 0.08).toFixed(2)}>
          <h3 class="solucao-card__title">{item.title}</h3>
          <p class="solucao-card__desc">{item.desc}</p>
          <div class="solucao-card__line"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .solucoes {
    background: var(--bg);
  }
  .solucoes__header {
    margin-bottom: 3.5rem;
  }
  .solucoes__title {
    max-width: 20ch;
  }
  .solucoes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 3rem 2.5rem;
  }

  .solucao-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .solucao-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .solucao-card__desc {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .solucao-card__line {
    width: 100%;
    height: 1px;
    background: var(--line);
    margin-top: auto;
    transition: background-color 0.3s;
  }
  .solucao-card:hover .solucao-card__line {
    background: var(--primary);
  }
</style>
