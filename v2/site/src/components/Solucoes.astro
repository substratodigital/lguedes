---
import { type Lang, useT } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="solucoes" class="section solucoes">
  <div class="container">
    <div class="solucoes__header" data-reveal>
      <div>
        <span class="eyebrow">{t.solucoes.label}</span>
        <h2 class="h2 solucoes__title">{t.solucoes.h2}</h2>
      </div>
      {t.solucoes.lead && <p class="solucoes__lead">{t.solucoes.lead}</p>}
    </div>

    <div class="solucoes__grid">
      {t.solucoes.items.map((item: any, i: number) => (
        <div class="solucao-card" data-reveal data-delay={(i * 0.08).toFixed(2)}>
          {item.tag && <span class="solucao-card__tag font-mono">{item.tag}</span>}
          <h3 class="solucao-card__title">{item.title}</h3>
          <p class="solucao-card__desc">{item.desc}</p>
          <div class="solucao-card__line"></div>
        </div>
      ))}
    </div>

    <div class="solucoes__cta" data-reveal>
      <a href="#contato" class="btn">
        {t.solucoes.cta ?? (lang === 'pt' ? 'Converse sobre um desafio' : 'Discuss a strategic challenge')}
        <Icon name="ArrowRight" size={18} stroke={2} />
      </a>
    </div>
  </div>
</section>

<style>
  .solucoes {
    background: var(--bg);
  }
  .solucoes__header {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }
  @media (min-width: 900px) {
    .solucoes__header {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 2.5rem;
    }
  }
  .solucoes__title {
    max-width: 24ch;
  }
  .solucoes__lead {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .solucoes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem 2.5rem;
  }

  .solucao-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .solucao-card__tag {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin-bottom: 0.45rem;
  }
  .solucao-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .solucao-card__desc {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .solucao-card__line {
    width: 100%;
    height: 1px;
    background: var(--line);
    margin-top: auto;
    transition: background-color 0.3s;
  }
  .solucao-card:hover .solucao-card__line {
    background: var(--primary);
  }
  .solucoes__cta {
    margin-top: 3rem;
    display: flex;
    justify-content: flex-start;
  }
</style>
