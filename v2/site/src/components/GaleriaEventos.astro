---

<section id="eventos" class="section ev-gallery" aria-labelledby="ev-gallery-title">
  <div class="container">
    <div class="ev-gallery__head" data-reveal>
      <div>
        <span class="eyebrow">{copy.label}</span>
        <h2 class="h2 ev-gallery__title" id="ev-gallery-title">{copy.h2}</h2>
      </div>
      <p class="ev-gallery__lead">{copy.p}</p>
    </div>
  </div>

  <div class="ev-gallery__stage" data-reveal>
    <!-- Fileira 1: movimento contínuo para a esquerda -->
    <div class="ev-row" data-ev-row data-speed="36" data-dir="1">
      <div class="ev-row__track" data-ev-track>
        {[0, 1].map((dup) => (
          <div class="ev-row__set" aria-hidden={dup === 1 ? 'true' : undefined}>
            {copy.row1.map((item) => (
              <figure class="ev-card">
                <div class="ev-card__frame">
                  <img
                    src={item.src}
                    alt={dup === 0 ? item.alt : ''}
                    width="800"
                    height="540"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="ev-card__tag font-mono">{item.tag}</figcaption>
                </div>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Fileira 2: movimento contínuo para a direita -->
    <div class="ev-row" data-ev-row data-speed="40" data-dir="-1">
      <div class="ev-row__track" data-ev-track>
        {[0, 1].map((dup) => (
          <div class="ev-row__set" aria-hidden={dup === 1 ? 'true' : undefined}>
            {copy.row2.map((item) => (
              <figure class="ev-card">
                <div class="ev-card__frame">
                  <img
                    src={item.src}
                    alt={dup === 0 ? item.alt : ''}
                    width="800"
                    height="540"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="ev-card__tag font-mono">{item.tag}</figcaption>
                </div>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ev-gallery {
    background: var(--bg);
    overflow: hidden;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .ev-gallery__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .ev-gallery__title {
    max-width: 22ch;
  }

  .ev-gallery__lead {
    max-width: 42ch;
    font-size: 0.975rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .ev-gallery__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 1.8vw, 1.35rem);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 5%, #000 95%, transparent 100%);
  }

  .ev-row {
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
    cursor: grab;
  }
  .ev-row:active {
    cursor: grabbing;
  }

  .ev-row__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .ev-row__set {
    display: flex;
    gap: clamp(0.85rem, 1.8vw, 1.35rem);
    padding-right: clamp(0.85rem, 1.8vw, 1.35rem);
  }

  .ev-card {
    flex: 0 0 auto;
    width: clamp(240px, 28vw, 370px);
    aspect-ratio: 800 / 540;
    margin: 0;
  }

  .ev-card__frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out), border-color 0.3s;
  }

  .ev-card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 52%, hsl(240 25% 8% / 0.68) 100%);
    opacity: 0.78;
    transition: opacity 0.35s var(--ease-out);
    pointer-events: none;
  }

  .ev-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.005);
    filter: saturate(0.92) contrast(1.03);
    transition: transform 0.65s var(--ease-out), filter 0.45s var(--ease-out);
    pointer-events: none;
  }

  .ev-card:hover .ev-card__frame {
    transform: translateY(-3px);
    border-color: hsl(243 75% 59% / 0.38);
    box-shadow: var(--shadow);
  }

  .ev-card:hover img {
    transform: scale(1.055);
    filter: saturate(1.05) contrast(1.05);
  }

  .ev-card__tag {
    position: absolute;
    left: 0.85rem;
    bottom: 0.8rem;
    z-index: 2;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: hsl(240 20% 10% / 0.58);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid hsl(0 0% 100% / 0.18);
    padding: 0.28rem 0.68rem;
    border-radius: var(--radius-pill);
    transition: background-color 0.25s, border-color 0.25s, transform 0.3s var(--ease-out);
  }

  .ev-card:hover .ev-card__tag {
    background: var(--primary);
    border-color: hsl(0 0% 100% / 0.35);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .ev-card {
      width: clamp(220px, 68vw, 290px);
    }
    .ev-gallery__stage {
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 3%, #000 97%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 3%, #000 97%, transparent 100%);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-ev-row]').forEach((row) => {
    const track = row.querySelector<HTMLElement>('[data-ev-track]')!;
    const set = track.firstElementChild as HTMLElement;
    const speed = Number(row.dataset.speed || 38);
    const dir = Number(row.dataset.dir || 1);
    if (reduced) return;

    let tween: gsap.core.Tween | null = null;
    let visible = false;

    const build = () => {
      tween?.kill();
      const w = set.offsetWidth;
      if (!w) return;
      gsap.set(track, { x: dir > 0 ? 0 : -w });
      tween = gsap.to(track, {
        x: dir > 0 ? -w : 0,
        duration: w / speed,
        ease: 'none',
        repeat: -1,
      });
      if (!visible) tween.pause();
    };

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      visible ? tween?.play() : tween?.pause();
    }, { rootMargin: '150px' }).observe(row);

    row.addEventListener('pointerenter', () => tween && gsap.to(tween, { timeScale: 0.2, duration: 0.5, ease: 'power2.out' }));
    row.addEventListener('pointerleave', () => tween && gsap.to(tween, { timeScale: 1, duration: 0.5, ease: 'power2.in' }));

    // Suporte a arraste suave (touch / mouse)
    let startX = 0;
    let startProg = 0;
    let dragging = false;

    row.addEventListener('pointerdown', (e) => {
      if (!tween) return;
      dragging = true;
      startX = e.clientX;
      startProg = tween.progress();
      tween.pause();
    });

    window.addEventListener('pointermove', (e) => {
      if (!dragging || !tween) return;
      const w = set.offsetWidth || 1;
      let p = startProg - ((e.clientX - startX) / w) * dir;
      p = ((p % 1) + 1) % 1;
      tween.progress(p);
    }, { passive: true });

    window.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      if (visible) {
        tween?.play();
        gsap.to(tween, { timeScale: 1, duration: 0.4 });
      }
    });

    let rt = 0;
    new ResizeObserver(() => {
      clearTimeout(rt);
      rt = window.setTimeout(build, 120);
    }).observe(set);

    build();
  });
</script>

