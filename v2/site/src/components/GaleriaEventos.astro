    label: 'IN ACTION · EVENT HISTORY',
    h2: 'Stages, executive forums, and academic immersions',
    p: 'Moments from keynotes, conferences, leadership programs, and awards across more than three decades connecting science, strategy, and business.',
    row1: [
      { src: '/img/eventos/evento-01.webp', tag: 'Executive Keynote', alt: 'Prof. Luís Guedes delivering an executive keynote' },
      { src: '/img/eventos/evento-02.webp', tag: 'In-Company Immersion', alt: 'Prof. Luís Guedes teaching an executive class' },
      { src: '/img/eventos/evento-03.webp', tag: 'APAS Show · AI Ethics', alt: 'Ethics and Transparency in AI keynote at APAS Show' },
