      { src: '/img/eventos/evento-11.webp', tag: 'FIA Business School', alt: 'Prof. Luís Guedes em palestra pela FIA Business School' },
      { src: '/img/eventos/evento-12.webp', tag: 'Semana Economia Criativa', alt: 'Painel na Semana de Economia Criativa' },
      { src: '/img/eventos/evento-13.webp', tag: 'Mérito Acadêmico', alt: 'Entrega de placa de homenagem acadêmica' },
      { src: '/img/eventos/evento-14.webp', tag: 'Transmissão & Conteúdo', alt: 'Bastidores de gravação e palestra ao vivo' },
      { src: '/img/eventos/evento-15.webp', tag: 'Reconhecimento Institucional', alt: 'Homenagem institucional ao Prof. Luís Guedes' },
      { src: '/img/eventos/evento-16.webp', tag: 'Arena Executiva', alt: 'Apresentação em arena principal de tecnologia' },
