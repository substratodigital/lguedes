      { src: '/img/eventos/evento-09.webp', tag: 'ABEVD Congress', alt: 'Narratives of a New Future — ABEVD National Congress' },
      { src: '/img/eventos/evento-10.webp', tag: 'Management Development', alt: 'Cohort celebration with Prof. Luís Guedes' },
