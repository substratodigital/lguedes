---
import { type Lang, useT } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const items = t.palestras.items as any[];
---

<section id="palestras" class="section palestras">
  <div class="container">
    <div class="pal__header" data-reveal>
      <span class="eyebrow">{t.palestras.label}</span>
      <h2 class="h2">{t.palestras.h2}</h2>
    </div>

    <div class="pal">
      <!-- Seletor lateral -->
      <div class="pal__tabs" role="tablist" aria-label={t.palestras.h2}>
        {items.map((item, i) => (
          <button
            type="button"
            role="tab"
            class:list={['pal__tab', { 'is-active': i === 0 }]}
            id={`pal-tab-${item.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`pal-panel-${item.id}`}
            data-pal-tab={i}
            style={`--accent:${item.accentColor}`}
          >
            <span class="pal__tab-bar" aria-hidden="true"></span>
            <span class="pal__tab-num font-mono">{item.num}</span>
            <span class="pal__tab-title">{item.title}</span>
            <span class="pal__tab-badge">{item.badge}</span>
          </button>
        ))}
        <a href="#contato" class="pal__cta pal__cta--desk">
          {t.palestras.cta}
          <Icon name="ArrowRight" size={16} />
        </a>
      </div>

      <div class="pal__divider" aria-hidden="true"></div>

      <!-- Painéis -->
      <div class="pal__panels">
        {items.map((p, i) => (
          <div
            class:list={['pal__panel', { 'is-active': i === 0 }]}
            id={`pal-panel-${p.id}`}
            role="tabpanel"
            aria-labelledby={`pal-tab-${p.id}`}
            hidden={i !== 0}
            style={`--accent:${p.accentColor}`}
          >
            <div class="pal__meta" data-pal-in>
              <span class="pal__meta-num font-mono">{p.num} /</span>
              <span class="pal__badge">
                <Icon name="Megaphone" size={12} stroke={2} />
                {p.badge}
              </span>
              <span class="pal__audience">{p.audience}</span>
            </div>

            <h3 class="pal__title" data-pal-in>{p.title}</h3>
            <p class="pal__tagline font-mono" data-pal-in>— {p.tagline}</p>
            <p class="pal__desc" data-pal-in>{p.fullDesc}</p>

            <div class="pal__sep"></div>

            <div class="pal__details">
              {p.details.map((d: any) => (
                <>
                  {d.kind === 'grid' && (
                    <div class="pal__grid">
                      {d.items.map((it: any) => (
                        <div class="pal__box" data-pal-in>
                          <h4 class="pal__box-title">{it.title}</h4>
                          <p class="pal__box-desc">{it.desc}</p>
                        </div>
                      ))}
                    </div>
                  )}

                  {d.kind === 'two-col' && (
                    <div class="pal__twocol">
                      {[d.left, d.right].map((side: any) => (
                        <div class="pal__col">
                          <div class="pal__col-head" data-pal-in>
                            {side.icon === 'check'
                              ? <span class="pal__ico pal__ico--ok"><Icon name="CircleCheck" size={20} /></span>
                              : <span class="pal__ico pal__ico--warn"><Icon name="TriangleAlert" size={20} /></span>}
                            <span>{side.label}</span>
                          </div>
                          {side.items.map((it: any) => (
                            <div class="pal__box" data-pal-in>
                              <h4 class="pal__box-title">{it.title}</h4>
                              <p class="pal__box-desc">{it.desc}</p>
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  )}

                  {d.kind === 'quote' && (
                    <blockquote class="pal__quote" data-pal-in>
                      <p>"{d.text}"</p>
                    </blockquote>
                  )}
                </>
              ))}
            </div>

            <a href="#contato" class="pal__cta pal__cta--mob">
              {t.palestras.cta}
              <Icon name="ArrowRight" size={16} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .palestras { background: var(--bg); }
  .pal__header { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .pal__header .h2 { max-width: 18ch; }

  .pal { display: flex; flex-direction: column; }
  @media (min-width: 1024px) { .pal { flex-direction: row; align-items: stretch; } }

  /* ── Seletor lateral ── */
  .pal__tabs {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    border-block: 1px solid var(--line);
    scrollbar-width: none;
  }
  .pal__tabs::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) {
    .pal__tabs { flex-direction: column; width: 320px; flex-shrink: 0; overflow: visible; border-bottom: 0; }
  }

  .pal__tab {
    position: relative; flex: 0 0 260px; scroll-snap-align: start;
    text-align: left; padding: 1.1rem 1.4rem;
    border-right: 1px solid var(--line);
    transition: background-color .25s;
    display: flex; flex-direction: column; gap: .25rem;
  }
  @media (min-width: 1024px) {
    .pal__tab { flex: none; width: 100%; border-right: 0; border-bottom: 1px solid var(--line); padding: 1.5rem 1.6rem; }
  }
  .pal__tab:hover { background: hsl(240 20% 20% / .025); }
  .pal__tab.is-active { background: hsl(240 20% 20% / .045); }

  .pal__tab-bar {
    position: absolute; left: 0; top: 0; width: 100%; height: 3px;
    background: var(--accent); transform: scaleX(0); transform-origin: left;
    transition: transform .45s var(--ease-out);
  }
  @media (min-width: 1024px) {
    .pal__tab-bar { width: 3px; height: 100%; transform: scaleY(0); transform-origin: top; }
  }
  .pal__tab.is-active .pal__tab-bar { transform: none; }

  .pal__tab-num { font-size: .8rem; color: var(--ink-3); transition: color .25s; }
  .pal__tab.is-active .pal__tab-num { color: var(--accent); }
  .pal__tab-title {
    font-size: clamp(1rem, .9rem + .4vw, 1.25rem); font-weight: 600; line-height: 1.3;
    white-space: pre-line; color: var(--ink-3); transition: color .25s;
  }
  .pal__tab:hover .pal__tab-title { color: var(--ink-2); }
  .pal__tab.is-active .pal__tab-title { color: var(--ink); }
  .pal__tab-badge { font-size: .85rem; color: hsl(240 5% 70%); transition: color .25s; }
  .pal__tab.is-active .pal__tab-badge { color: var(--ink-3); }

  .pal__cta {
    display: flex; align-items: center; justify-content: space-between;
    font-size: var(--fs-sm); font-weight: 600; color: var(--ink);
    border: 1px solid var(--line); padding: .85rem 1rem;
    transition: background-color .2s;
  }
  .pal__cta :global(.icon) { color: var(--ink-3); transition: transform .3s var(--ease-out); }
  .pal__cta:hover { background: hsl(240 20% 20% / .04); }
  .pal__cta:hover :global(.icon) { transform: translateX(4px); }
  .pal__cta--desk { display: none; }
  @media (min-width: 1024px) {
    .pal__cta--desk { display: flex; margin: 1.5rem 1.25rem 0; }
    .pal__cta--mob { display: none; }
  }
  .pal__cta--mob { margin-top: 2rem; }

  .pal__divider { display: none; }
  @media (min-width: 1024px) { .pal__divider { display: block; width: 1px; background: var(--line); flex-shrink: 0; } }

  /* ── Painel ── */
  .pal__panels { flex: 1; min-width: 0; border-top: 1px solid var(--line); }
  .pal__panel { padding: 2rem .25rem; display: flex; flex-direction: column; gap: 2rem; }
  @media (min-width: 768px) { .pal__panel { padding: 2.5rem; } }
  .pal__panel[hidden] { display: none; }

  .pal__meta { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-bottom: -1rem; }
  .pal__meta-num { font-size: var(--fs-xs); color: var(--ink-3); }
  .pal__badge {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .65rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
    padding: .3rem .65rem; color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .pal__audience { font-size: .7rem; color: var(--ink-3); border: 1px solid var(--line); padding: .3rem .65rem; }

  .pal__title {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem); font-weight: 700;
    letter-spacing: -0.025em; line-height: 1.12; white-space: pre-line; margin-bottom: -1.25rem;
  }
  .pal__tagline { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); margin-bottom: -.75rem; }
  .pal__desc { color: var(--ink-2); max-width: 62ch; font-size: .95rem; line-height: 1.7; }
  .pal__sep { height: 1px; background: var(--line); }

  .pal__details { display: flex; flex-direction: column; gap: 1.5rem; }
  .pal__grid, .pal__twocol { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .pal__grid, .pal__twocol { grid-template-columns: 1fr 1fr; } }
  .pal__col { display: flex; flex-direction: column; gap: 1rem; }
  .pal__col-head {
    display: flex; align-items: center; gap: .5rem;
    font-size: .8rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-3);
  }
  .pal__ico { display: inline-flex; }
  .pal__ico--ok { color: hsl(152 60% 40%); }
  .pal__ico--warn { color: hsl(38 92% 48%); }

  /* Tópicos com títulos destacados */
  .pal__box {
    border: 1px solid var(--line); background: hsl(240 20% 20% / .02);
    padding: 1.4rem 1.5rem;
    transition: border-color .25s, background-color .25s;
  }
  .pal__box:hover { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); background: var(--surface); }
  .pal__box-title {
    font-size: clamp(1rem, .95rem + .25vw, 1.125rem); font-weight: 700;
    text-transform: uppercase; letter-spacing: .03em; color: var(--ink); margin-bottom: .5rem;
  }
  .pal__box-desc { font-size: .925rem; color: var(--ink-2); line-height: 1.65; }

  .pal__quote { border-left: 2px solid var(--accent); padding: .25rem 0 .25rem 1.25rem; }
  .pal__quote p { font-family: var(--font-mono); font-style: italic; font-size: .9rem; color: var(--ink-2); line-height: 1.7; }
</style>

<script>
  import { gsap } from 'gsap';

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-pal-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.pal__panel'));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = 0;
  let busy = false;

  function enter(panel: HTMLElement) {
    const els = panel.querySelectorAll('[data-pal-in]');
    if (reduced) return;
    gsap.fromTo(els, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.04, ease: 'power3.out', overwrite: true });
  }

  function select(i: number) {
    if (i === current || busy) return;
    busy = true;
    tabs.forEach((t, k) => { t.classList.toggle('is-active', k === i); t.setAttribute('aria-selected', String(k === i)); });
    const out = panels[current];
    const inn = panels[i];
    const done = () => { out.hidden = true; inn.hidden = false; enter(inn); current = i; busy = false; };
    if (reduced) return done();
    gsap.to(out, { autoAlpha: 0, y: -8, duration: 0.2, ease: 'power2.in', onComplete: () => { gsap.set(out, { clearProps: 'all' }); done(); } });
  }

  tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));

  // Entrada inicial ao entrar na viewport
  const first = panels[0];
  if (first && !reduced) {
    gsap.set(first.querySelectorAll('[data-pal-in]'), { autoAlpha: 0, y: 14 });
    gsap.set(tabs, { autoAlpha: 0, x: -16 });
    new IntersectionObserver((entries, obs) => {
      if (!entries[0].isIntersecting) return;
      obs.disconnect();
      gsap.to(tabs, { autoAlpha: 1, x: 0, duration: 0.5, stagger: 0.08, ease: 'power3.out' });
      enter(first);
    }, { threshold: 0.15 }).observe(first);
  }
</script>
