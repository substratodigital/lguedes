---
import { type Lang } from '../i18n';
import { CONSULTORIA_DATA } from '../data/consultoria';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = CONSULTORIA_DATA[lang];
const isPt = lang === 'pt';

const territories = isPt
  ? [
      {
        icon: 'Compass' as const,
        accent: '#4F46E5',
        tag: 'Território Estratégico',
        title: 'Estratégia & Execução',
        desc: 'Planejamento estratégico (da revisão da intenção à execução técnica), governança da execução e Strategy Execution Sprint.',
        items: [
          'Planejamento estratégico da intenção à execução técnica',
          'Governança da execução e ritos de acompanhamento',
          'Strategy Execution Sprint e destravamento de prioridades',
        ],
      },
      {
        icon: 'Cpu' as const,
        accent: '#0D9488',
        tag: 'Prioridade Executiva · Parceria FIA Business School',
        title: 'IA & Transformação',
        desc: 'AI Adoption & Value Diagnostic, portfólio de casos de uso, business case e acompanhamento da geração de valor, governança e operating model de IA.',
        highlightTitle: 'Da experimentação ao valor',
        highlightText:
          'O trabalho conjunto com as lideranças técnicas e do negócio encaminha a identificação de casos de uso da IA com foco na criação responsável de valor. A análise do negócio, da arquitetura tecnológica e dos dados disponíveis é o fundamento para o projeto dos pilotos. A Consultoria elabora os business cases, estabelece a governança e apoia decisivamente o desenvolvimento das capacidades humanas e técnicas necessárias para escalar a adoção — em parceria com a FIA Business School.',
        items: [
          'AI Adoption & Value Diagnostic',
          'Portfólio de casos de uso e arquitetura de pilotos',
          'Business case, ROI e acompanhamento da geração de valor',
          'Governança, risco e operating model de IA',
        ],
      },
      {
        icon: 'Network' as const,
        accent: '#6366F1',
        tag: 'Arquitetura & Capacidades',
        title: 'Organização & Liderança',
        desc: 'Modelo de gestão (governança da decisão, incentivos, papéis e responsabilidades das estruturas de gestão), governança corporativa e compliance, capacidades organizacionais e desenvolvimento de lideranças.',
        items: [
          'Modelo de gestão: governança da decisão, alçadas e incentivos',
          'Papéis, responsabilidades e interfaces das estruturas de gestão',
          'Governança corporativa, integridade e compliance',
          'Desenvolvimento de lideranças para conduzir a execução das mudanças',
        ],
      },
    ]
  : [
      {
        icon: 'Compass' as const,
        accent: '#4F46E5',
        tag: 'Strategic Territory',
        title: 'Strategy & Execution',
        desc: 'Strategic planning (from strategic intent review to technical execution), execution governance, and Strategy Execution Sprint.',
        items: [
          'End-to-end strategic planning from intent to technical execution',
          'Execution governance and executive tracking cadences',
          'Strategy Execution Sprint and priority alignment',
        ],
      },
      {
        icon: 'Cpu' as const,
        accent: '#0D9488',
        tag: 'Executive Priority · FIA Business School Partnership',
        title: 'AI & Transformation',
        desc: 'AI Adoption & Value Diagnostic, use-case portfolio, business case and value-capture tracking, AI governance and operating model.',
        highlightTitle: 'From experimentation to value',
        highlightText:
          'Joint work with technical and business leaders drives the identification of AI use cases focused on responsible value creation. Analyzing the business, technology architecture, and available data forms the foundation for pilot design. The practice builds the business cases, establishes governance, and decisively supports the development of human and technical capabilities required to scale adoption — in partnership with FIA Business School.',
        items: [
          'AI Adoption & Value Diagnostic',
          'Prioritized use-case portfolio and pilot design',
          'Business case, value tracking, and ROI governance',
          'AI governance and operating model',
        ],
      },
      {
        icon: 'Network' as const,
        accent: '#6366F1',
        tag: 'Architecture & Capabilities',
        title: 'Organization & Leadership',
        desc: 'Management model (decision governance, incentives, roles and responsibilities across management structures), corporate governance and compliance, organizational capabilities, and leadership development.',
        items: [
          'Management model: decision rights, incentives, and structures',
          'Roles, responsibilities, and cross-unit interfaces',
          'Corporate governance and compliance',
          'Leadership development to lead change execution',
        ],
      },
    ];

const cases = isPt
  ? [
      {
        territory: 'Estratégia & Execução',
        sector: 'Setor Privado · Grande Empresa Regulada',
        accent: '#4F46E5',
        problem: 'Desconexão entre a ambição estratégica de longo prazo e a capacidade real de execução das diretorias, gerando pulverização de iniciativas e lentidão decisória.',
        challenges: 'Ambiente altamente regulado, múltiplos stakeholders internos e fadiga de projetos sem critério claro de priorização ou descontinuidade.',
        project: 'Diagnóstico estratégico integrado, revisão do direcionamento plurianual, síntese executiva de prioridades (Parar / Continuar / Iniciar) e implantação de governança da execução.',
        results: 'Foco executivo restaurado com corte de iniciativas de baixo retorno, alinhamento entre diretorias e ganho de velocidade na entrega das prioridades críticas do negócio.',
        quote: 'Guedes reúne uma combinação rara de profundidade técnica e visão executiva para decisões fundamentadas em dados e ciência.',
      },
      {
        territory: 'IA & Transformação',
        sector: 'Setor Privado · Operação Intensiva em Dados e Tecnologia',
        accent: '#0D9488',
        problem: 'Multiplicação de experimentos isolados de IA sem business case estruturado, governança de risco ou integração com os processos críticos de negócio.',
        challenges: 'Necessidade de sair do hype tecnológico para captura real de eficiência operacional, mantendo segurança, supervisão humana e capacitação das lideranças.',
        project: 'AI Adoption & Value Diagnostic, priorização de portfólio de casos de uso com análise da arquitetura de dados, modelagem de business case e programa de desenvolvimento gerencial com chancela FIA.',
        results: 'Transição estruturada da experimentação para geração de valor mensurável, com operating model de IA definido, redução de retrabalho operacional e líderes capacitados.',
        quote: 'Capacidade ímpar de transformar o complexo em uma narrativa clara, acionável e orientada a resultado.',
      },
      {
        territory: 'Organização & Liderança',
        sector: 'Alta Complexidade · Grande Organização Multi-Stakeholder',
        accent: '#6366F1',
        problem: 'Estrutura organizacional e modelo de gestão defasados frente ao crescimento da operação, causando sobreposição de escopo, atrito entre áreas e gargalos na alta administração.',
        challenges: 'Cultura organizacional consolidada, alta interdependência técnica entre unidades e necessidade de preservar a continuidade operacional durante a transição.',
        project: 'Redesign da cadeia de valor e macroprocessos, revisão da estrutura organizacional, novo modelo de governança decisória e trilha de desenvolvimento de lideranças.',
        results: 'Clareza de papéis, alçadas e interfaces entre unidades, destravamento da tomada de decisão executiva e fortalecimento da accountability em toda a liderança.',
        quote: 'Visão pragmática com soluções bem encaminhadas que conectam estratégia, pessoas e governança.',
      },
    ]
  : [
      {
        territory: 'Strategy & Execution',
        sector: 'Private Sector · Large Regulated Enterprise',
        accent: '#4F46E5',
        problem: 'Disconnect between long-term strategic ambition and actual execution capacity across business units, leading to fragmented initiatives and slow decisions.',
        challenges: 'Highly regulated environment, multiple stakeholders, and project fatigue without clear stop/continue/start criteria.',
        project: 'Integrated strategic diagnostic, multi-year direction review, executive priority synthesis (Stop / Continue / Start), and execution governance implementation.',
        results: 'Restored executive focus by eliminating low-return initiatives, aligning leadership teams, and accelerating delivery of mission-critical priorities.',
        quote: 'A rare combination of technical depth and executive vision for data- and science-driven decisions.',
      },
      {
        territory: 'AI & Transformation',
        sector: 'Private Sector · Technology & Data-Intensive Operation',
        accent: '#0D9488',
        problem: 'Isolated AI experiments lacking structured business cases, risk governance, or integration with core business processes.',
        challenges: 'Moving beyond technological hype to capture real operational efficiency while ensuring human oversight, governance, and leadership readiness.',
        project: 'AI Adoption & Value Diagnostic, prioritized use-case portfolio grounded in data architecture, business-case modeling, and FIA-certified leadership enablement.',
        results: 'Structured transition from experimentation to measurable value capture, with a clear AI operating model, reduced rework, and capable leadership.',
        quote: 'Unique ability to turn complexity into a clear, actionable, results-oriented roadmap.',
      },
      {
        territory: 'Organization & Leadership',
        sector: 'High Complexity · Multi-Stakeholder Institution',
        accent: '#6366F1',
        problem: 'Legacy organizational structure and management model creating scope overlap, cross-functional friction, and C-level decision bottlenecks.',
        challenges: 'Deeply established culture, high technical interdependence across units, and need for seamless operational continuity during transition.',
        project: 'Value-chain and macroprocess redesign, organizational structure review, new decision-governance architecture, and leadership development program.',
        results: 'Clear mandates, decision rights, and cross-unit interfaces, faster executive decision-making, and stronger organizational accountability.',
        quote: 'Pragmatic vision with well-structured solutions connecting strategy, people, and governance.',
      },
    ];

// ── Radar de intervenção: a jornada de contratação em espiral
// (do centro, entrada leve, para fora, intervenções mais amplas).
// Os anéis são as fases de "Como atuamos".
const phases = isPt
  ? ['Diagnóstico', 'Estruturação', 'Implementação', 'Transferência de conhecimento']
  : ['Diagnosis', 'Structuring', 'Implementation', 'Knowledge transfer'];
const ringBounds = [0.14, 0.38, 0.58, 0.78, 0.98];

const radarRaw = isPt
  ? [
      { title: 'Executive Session', desc: 'Conversa executiva focal para enquadrar o desafio, alinhar expectativas e definir o ponto de partida mais adequado.', phase: 0, angle: 0, r: 0 },
      { title: 'Workshop', desc: 'Imersões práticas de alinhamento estratégico, priorização executiva e letramento decisório em IA.', phase: 0, angle: 48, r: 0.27 },
      { title: 'Diagnóstico & Advisory', desc: 'Leitura independente de cenário, maturidade e escolhas críticas para o C-level e conselho.', phase: 0, angle: 108, r: 0.33 },
      { title: 'Sprint', desc: 'Ciclos executivos intensivos de curta duração para destravar decisões, estratégia ou casos de uso de IA.', phase: 1, angle: 165, r: 0.49 },
      { title: 'Projeto Estruturante', desc: 'Redesenho completo de estratégia, modelo de gestão, processos, governança ou transformação com IA.', phase: 2, angle: 222, r: 0.68 },
      { title: 'Programa Executivo', desc: 'Desenvolvimento gerencial customizado com chancela FIA Business School para liderar a mudança.', phase: 3, angle: 282, r: 0.84 },
      { title: 'Guidance & Operação Assistida', desc: 'Acompanhamento contínuo da implementação, governança de valor e transferência de conhecimento.', phase: 3, angle: 334, r: 0.9 },
    ]
  : [
      { title: 'Executive Session', desc: 'Focused executive conversation to frame the challenge, align expectations, and define the right starting point.', phase: 0, angle: 0, r: 0 },
      { title: 'Workshop', desc: 'Hands-on executive alignment, prioritization, and AI decision-making immersions.', phase: 0, angle: 48, r: 0.27 },
      { title: 'Diagnostic & Advisory', desc: 'Independent reading of scenario, maturity, and critical choices for C-level and board.', phase: 0, angle: 108, r: 0.33 },
      { title: 'Sprint', desc: 'Short, high-intensity executive cycles to unlock strategic decisions or AI use cases.', phase: 1, angle: 165, r: 0.49 },
      { title: 'Structuring Project', desc: 'Full redesign of strategy, management model, processes, governance, or AI transformation.', phase: 2, angle: 222, r: 0.68 },
      { title: 'Executive Program', desc: 'Custom leadership development in partnership with FIA Business School to sustain execution.', phase: 3, angle: 282, r: 0.84 },
      { title: 'Guidance & Assisted Operation', desc: 'Ongoing implementation guidance, value governance, and team knowledge transfer.', phase: 3, angle: 334, r: 0.9 },
    ];

const radarItems = radarRaw.map((it) => {
  const a = (it.angle * Math.PI) / 180;
  return {
    ...it,
    phaseLabel: phases[it.phase],
    x: +(50 + it.r * 50 * Math.sin(a)).toFixed(2),
    y: +(50 - it.r * 50 * Math.cos(a)).toFixed(2),
  };
});

// textura estática do radar (determinística no build)
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const radarNoise = Array.from({ length: 46 }, () => {
  const a = rnd() * Math.PI * 2;
  const r = 30 + rnd() * 160;
  return { cx: +(200 + r * Math.cos(a)).toFixed(1), cy: +(200 + r * Math.sin(a)).toFixed(1), r: +(0.6 + rnd() * 1.1).toFixed(2) };
});

const caseKinds = ['strategy', 'ai', 'org'] as const;
const caseHud = isPt
  ? ['intenção → execução', 'experimentação → valor', 'papéis · alçadas · interfaces']
  : ['intent → execution', 'experimentation → value', 'roles · decision rights · interfaces'];
---

<section class="section consultoria" id="consultoria" aria-labelledby="consultoria-h2">
  <div class="container">
    <!-- ── 1. HEADER & POSICIONAMENTO ── -->
    <header class="consultoria__head" data-reveal>
      <div class="consultoria__head-main">
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="h2 consultoria__title" id="consultoria-h2">{data.h2}</h2>
      </div>
      <div class="consultoria__head-side">
        <p class="lead consultoria__lead">{data.lead}</p>
      </div>
    </header>

    <!-- ── 2. OS 3 TERRITÓRIOS DA CONSULTORIA ESTRATÉGICA ── -->
    <div class="territories" data-reveal>
      <div class="territories__grid">
        {territories.map((t) => (
          <article class="tcard" style={`--t-accent: ${t.accent}`}>
            <div class="tcard__top">
              <span class="tcard__icon">
                <Icon name={t.icon} size={20} stroke={1.75} />
              </span>
              <span class="tcard__tag font-mono">{t.tag}</span>
            </div>

            <h3 class="tcard__title">{t.title}</h3>
            <p class="tcard__desc">{t.desc}</p>

            {t.highlightTitle && (
              <div class="tcard__ia-box">
                <span class="tcard__ia-badge font-mono">
                  <Icon name="Sparkles" size={13} stroke={2} />
                  {t.highlightTitle}
                </span>
                <p class="tcard__ia-text">{t.highlightText}</p>
              </div>
            )}

          </article>
        ))}
      </div>
    </div>

    <!-- ── 3. FORMAS DE INTERVENÇÃO — RADAR CONTÍNUO ── -->
    <div class="radar-block" data-reveal>
      <div class="radar-block__head">
        <div>
          <span class="eyebrow">{isPt ? 'FORMAS DE INTERVENÇÃO' : 'ENGAGEMENT FORMATS'}</span>
          <h3 class="h3 radar-block__title">
            {isPt
              ? 'Nem todo problema exige começar por um grande projeto.'
              : 'Not every challenge requires starting with a massive project.'}
          </h3>
        </div>
        <p class="radar-block__sub">
          {isPt
            ? 'Podemos iniciar por uma sessão executiva, workshop ou diagnóstico focal e ampliar a intervenção somente quando problema, evidência e valor justificarem.'
            : 'We can start with an executive session, workshop, or focused diagnostic, expanding the intervention only when problem, evidence, and value justify it.'}
        </p>
      </div>

      <div class="radar" data-radar>
        <div class="radar__stage">
          <div class="radar__scope" data-radar-scope>
            <svg class="radar__svg" viewBox="0 0 400 400" aria-hidden="true">
              <defs>
                <radialGradient id={`radarGlow-${lang}`} cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#4F46E5" stop-opacity="0.10" />
                  <stop offset="70%" stop-color="#4F46E5" stop-opacity="0.025" />
                  <stop offset="100%" stop-color="#4F46E5" stop-opacity="0" />
                </radialGradient>
              </defs>
              <circle cx="200" cy="200" r="196" fill={`url(#radarGlow-${lang})`} />
              {ringBounds.slice(1).map((b, i) => (
                <circle
                  class:list={['radar__ring', `radar__ring--${i}`]}
                  cx="200" cy="200" r={(b * 200).toFixed(1)}
                />
              ))}
              <circle class="radar__core" cx="200" cy="200" r={(ringBounds[0] * 200).toFixed(1)} />
              <line class="radar__axis" x1="200" y1="6" x2="200" y2="394" />
              <line class="radar__axis" x1="6" y1="200" x2="394" y2="200" />
              <line class="radar__axis radar__axis--diag" x1="62" y1="62" x2="338" y2="338" />
              <line class="radar__axis radar__axis--diag" x1="338" y1="62" x2="62" y2="338" />
              {radarNoise.map((n) => <circle class="radar__noise" cx={n.cx} cy={n.cy} r={n.r} />)}
              {phases.map((ph, i) => (
                <text
                  class="radar__ring-label"
                  text-anchor="end"
                  x="195"
                  y={(200 - ((ringBounds[i] + ringBounds[i + 1]) / 2) * 200 + 2.5).toFixed(1)}
                >{ph.split(' ')[0]}</text>
              ))}
            </svg>

            <div class="radar__sweep" data-radar-sweep aria-hidden="true"><i></i></div>

            {radarItems.map((it) => (
              <button
                type="button"
                class:list={['radar__blip', { 'radar__blip--core': it.r === 0 }]}
                data-radar-blip
                data-angle={it.angle}
                data-title={it.title}
                data-phase={it.phaseLabel}
                data-desc={it.desc}
                style={`--x: ${it.x}%; --y: ${it.y}%;`}
                aria-label={`${it.title} — ${it.desc}`}
              >
                <span class="radar__blip-dot" aria-hidden="true"></span>
                <span class:list={['radar__blip-label', { 'is-left': it.x < 47 && it.x > 20 }]} aria-hidden="true">{it.title}</span>
              </button>
            ))}
          </div>

          <div class="radar__pop" data-radar-pop role="status" aria-live="polite">
            <span class="radar__pop-phase font-mono" data-pop-phase>{radarItems[0].phaseLabel}</span>
            <strong class="radar__pop-title" data-pop-title>{radarItems[0].title}</strong>
            <p class="radar__pop-desc" data-pop-desc>{radarItems[0].desc}</p>
          </div>
        </div>

        <aside class="radar__side">
          <div class="radar__group">
            <span class="radar__label font-mono">{isPt ? 'Formas de começar' : 'Ways to start'}</span>
            <div class="radar__steps" role="group" aria-label={isPt ? 'Formas de começar' : 'Ways to start'}>
              {radarItems.map((it, i) => (
                <button type="button" class:list={['radar__step', { 'is-active': i === 0 }]} data-radar-step aria-pressed={i === 0 ? 'true' : 'false'}>
                  <span class="radar__step-dot" aria-hidden="true"></span>
                  <span>{it.title}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="radar__group radar__group--phases">
            <span class="radar__label font-mono">{isPt ? 'Como atuamos' : 'How we work'}</span>
            <ul class="radar__phases">
              {phases.map((ph, i) => (
                <li style={`--ring: ${i}`}><span class="radar__phase-ring" aria-hidden="true"></span>{ph}</li>
              ))}
            </ul>
            <p class="radar__hint">
              {isPt
                ? 'Do centro para fora: cada anel é uma fase de atuação e cada ponto, uma forma de intervenção.'
                : 'From the center outward: each ring is a delivery phase and each point an engagement format.'}
            </p>
          </div>

          <a href="#contato" class="btn radar__cta">
            {isPt ? 'Converse sobre um desafio' : 'Discuss a strategic challenge'}
            <Icon name="ArrowRight" size={18} stroke={2} />
          </a>
        </aside>
      </div>
    </div>

    <!-- ── 4. EXPERIÊNCIA SELECIONADA EM CONSULTORIA (3 MINI-CASES COM MOTION) ── -->
    <div class="cases-block" data-reveal>
      <div class="cases-block__head">
        <div>
          <span class="eyebrow">{isPt ? 'EVIDÊNCIA DE CAPACIDADE' : 'PROVEN TRACK RECORD'}</span>
          <h3 class="h3 cases-block__title">
            {isPt ? 'Experiência selecionada em consultoria' : 'Selected consulting experience'}
          </h3>
        </div>
        <p class="cases-block__sub">
          {isPt
            ? 'Setor privado como mercado-alvo prioritário e setor público como evidência de capacidade em ambientes regulados, intensivos em tecnologia e múltiplos stakeholders.'
            : 'Private sector as priority target market and public sector as proof of capability in regulated, technology-intensive, multi-stakeholder environments.'}
        </p>
      </div>

      <div class="cases__viewport">
        <div class="cases__track" data-cases-track>
          {cases.map((c, i) => (
            <article class="case-card" data-case-card style={`--c-accent: ${c.accent}`}>
              <div class="case-card__stage">
                <div class="case-card__grid" aria-hidden="true"></div>
                <canvas class="case-card__canvas" data-case-canvas={caseKinds[i]} aria-hidden="true"></canvas>
                <span class="case-card__hud font-mono" aria-hidden="true">{caseHud[i]}</span>
              </div>

              <div class="case-card__body">
                <div class="case-card__head">
                  <h4 class="case-card__territory">{c.territory}</h4>
                  <span class="case-card__sector font-mono">{c.sector}</span>
                </div>

                <div class="case-card__item">
                  <span class="case-card__label font-mono">{isPt ? 'Tipo de problema' : 'Problem type'}</span>
                  <p class="case-card__text">{c.problem}</p>
                </div>

                <div class="case-card__item">
                  <span class="case-card__label font-mono">{isPt ? 'Desafios e particularidades' : 'Challenges & specifics'}</span>
                  <p class="case-card__text">{c.challenges}</p>
                </div>

                <div class="case-card__item">
                  <span class="case-card__label font-mono">{isPt ? 'Projeto executado' : 'Project delivered'}</span>
                  <p class="case-card__text">{c.project}</p>
                </div>

                <div class="case-card__item case-card__item--result">
                  <span class="case-card__label font-mono">{isPt ? 'Resultados alcançados' : 'Results achieved'}</span>
                  <p class="case-card__text">{c.results}</p>
                </div>

                <blockquote class="case-card__quote">
                  <p>"{c.quote}"</p>
                </blockquote>
              </div>
            </article>
          ))}
        </div>
        <div class="cases__dots" role="group" aria-label={isPt ? 'Navegar entre os cases' : 'Browse cases'}>
          {cases.map((c) => (
            <button type="button" class="cases__dot" data-cases-dot aria-label={c.territory}></button>
          ))}
        </div>
      </div>
    </div>

    <!-- ── 5. CATÁLOGO DETALHADO DE PRODUTOS (2 EIXOS INTERATIVOS) ── -->
    <div class="portfolio-subheader" data-reveal>
      <div>
        <span class="eyebrow">{isPt ? 'ARQUITETURA DE SOLUÇÕES E ENTREGÁVEIS' : 'SOLUTIONS & DELIVERABLES ARCHITECTURE'}</span>
        <h3 class="h3">{isPt ? 'Explore o portfólio completo de produtos de consultoria' : 'Explore the complete consulting product portfolio'}</h3>
      </div>
      <a href="#contato" class="btn">
        {isPt ? 'Converse sobre um desafio' : 'Discuss a strategic challenge'}
        <Icon name="ArrowRight" size={18} stroke={2} />
      </a>
    </div>

    <div class="consultoria__grid">
      {data.offers.map((offer, idx) => (
        <article
          class:list={['ccard', `ccard--${idx === 0 ? 'complexity' : 'efficiency'}`]}
          data-consultoria-card={idx === 0 ? 'complexity' : 'efficiency'}
          data-reveal
          style={`--card-accent: ${offer.accent}`}
        >
          <a href={offer.href} class="ccard__MainLink" aria-label={`${offer.title} — ${data.cardCta}`}></a>

          <!-- Top Interactive Minimalist Stage -->
          <div class="ccard__stage" data-stage>
            <div class="ccard__stage-grid" aria-hidden="true"></div>

            <!-- Interactive HTML5 Canvas for ultra-minimalist micro-animations -->
            <canvas
              class="ccard__canvas"
              data-card-canvas={idx === 0 ? 'complexity' : 'efficiency'}
              aria-hidden="true"
            ></canvas>

            <!-- Minimalist Geometric SVG Overlay -->
            {idx === 0 ? (
              <svg class="ccard__svg ccard__svg--complexity" viewBox="0 0 420 220" fill="none" aria-hidden="true">
                <!-- Isometric Governance Planes -->
                <g class="ccard__iso-group">
                  <polygon class="ccard__iso-plane ccard__iso-plane--1" points="210,36 318,78 210,120 102,78" />
                  <polygon class="ccard__iso-plane ccard__iso-plane--2" points="210,68 318,110 210,152 102,110" />
                  <polygon class="ccard__iso-plane ccard__iso-plane--3" points="210,100 318,142 210,184 102,142" />
                  <line class="ccard__iso-axis" x1="210" y1="24" x2="210" y2="196" stroke-dasharray="3 3" />
                  <circle class="ccard__iso-node ccard__iso-node--top" cx="210" cy="36" r="3.5" />
                  <circle class="ccard__iso-node ccard__iso-node--mid" cx="210" cy="110" r="4" />
                  <circle class="ccard__iso-node ccard__iso-node--bot" cx="210" cy="184" r="3.5" />
                </g>
              </svg>
            ) : (
              <svg class="ccard__svg ccard__svg--efficiency" viewBox="0 0 420 220" fill="none" aria-hidden="true">
                <!-- Minimalist Target Reticle & Horizon Line -->
                <line class="ccard__horizon" x1="24" y1="110" x2="396" y2="110" stroke-dasharray="2 4" />
                <g class="ccard__reticle" data-reticle>
                  <rect x="168" y="68" width="84" height="84" rx="6" class="ccard__reticle-box" />
                  <path d="M164 78 V64 H178" class="ccard__reticle-corner" />
                  <path d="M256 78 V64 H242" class="ccard__reticle-corner" />
                  <path d="M164 142 V156 H178" class="ccard__reticle-corner" />
                  <path d="M256 142 V156 H242" class="ccard__reticle-corner" />
                </g>
              </svg>
            )}

            <!-- Bottom HUD: apenas a identificação limpa no canto -->
            <div class="ccard__hud-bottom font-mono" aria-hidden="true">
              <span class="ccard__hud-status">
                {idx === 0
                  ? (lang === 'pt' ? 'arquitetura e governança' : 'architecture and governance')
                  : (lang === 'pt' ? 'eficiência e IA aplicada' : 'efficiency and applied AI')}
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="ccard__body">
            <h3 class="ccard__title">{offer.title}</h3>
            <p class="ccard__desc">{offer.cardSummary}</p>

            <!-- Interactive Product Chips (em coluna única alinhada) -->
            <div class="ccard__products" role="list" aria-label={data.solutionsCountLabel}>
              {offer.products.map((prod) => (
                <a
                  href={`${offer.href}#prod-${prod.id}`}
                  class="ccard__chip"
                  role="listitem"
                >
                  <span class="ccard__chip-num font-mono">{prod.num}</span>
                  <span class="ccard__chip-name">{prod.title}</span>
                </a>
              ))}
            </div>

            <!-- Card Footer CTA -->
            <div class="ccard__footer">
              <a href={offer.href} class="ccard__cta">
                <span class="ccard__cta-text">{data.cardCta}</span>
                <span class="ccard__cta-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .consultoria {
    position: relative;
    background:
      radial-gradient(ellipse 60% 45% at 15% 15%, hsl(243 75% 59% / 0.045), transparent 70%),
