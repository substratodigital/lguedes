---
import { type Lang } from '../i18n';
import { CONSULTORIA_DATA } from '../data/consultoria';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = CONSULTORIA_DATA[lang];
---

<section class="section consultoria" id="consultoria" aria-labelledby="consultoria-h2">
  <div class="container">
    <header class="consultoria__head" data-reveal>
      <div class="consultoria__head-main">
        <span class="eyebrow">{data.eyebrow}</span>
        <h2 class="h2 consultoria__title" id="consultoria-h2">{data.h2}</h2>
      </div>
      <p class="lead consultoria__lead">{data.lead}</p>
    </header>

    <div class="consultoria__grid">
      {data.offers.map((offer, idx) => (
        <article
          class:list={['ccard', `ccard--${idx === 0 ? 'complexity' : 'efficiency'}`]}
          data-consultoria-card={idx === 0 ? 'complexity' : 'efficiency'}
          data-reveal
          style={`--card-accent: ${offer.accent}`}
        >
          <a href={offer.href} class="ccard__MainLink" aria-label={`${offer.title} — ${data.cardCta}`}></a>

          <!-- Top Interactive Minimalist Stage -->
          <div class="ccard__stage" data-stage>
            <div class="ccard__stage-grid" aria-hidden="true"></div>

            <!-- Interactive HTML5 Canvas for ultra-minimalist micro-animations -->
            <canvas
              class="ccard__canvas"
              data-card-canvas={idx === 0 ? 'complexity' : 'efficiency'}
              aria-hidden="true"
            ></canvas>

            <!-- Minimalist Geometric SVG Overlay -->
            {idx === 0 ? (
              <svg class="ccard__svg ccard__svg--complexity" viewBox="0 0 420 220" fill="none" aria-hidden="true">
                <!-- Isometric Governance Planes -->
                <g class="ccard__iso-group">
                  <polygon class="ccard__iso-plane ccard__iso-plane--1" points="210,36 318,78 210,120 102,78" />
                  <polygon class="ccard__iso-plane ccard__iso-plane--2" points="210,68 318,110 210,152 102,110" />
                  <polygon class="ccard__iso-plane ccard__iso-plane--3" points="210,100 318,142 210,184 102,142" />
                  <line class="ccard__iso-axis" x1="210" y1="24" x2="210" y2="196" stroke-dasharray="3 3" />
                  <circle class="ccard__iso-node ccard__iso-node--top" cx="210" cy="36" r="3.5" />
                  <circle class="ccard__iso-node ccard__iso-node--mid" cx="210" cy="110" r="4" />
                  <circle class="ccard__iso-node ccard__iso-node--bot" cx="210" cy="184" r="3.5" />
                </g>
              </svg>
            ) : (
              <svg class="ccard__svg ccard__svg--efficiency" viewBox="0 0 420 220" fill="none" aria-hidden="true">
                <!-- Minimalist Target Reticle & Horizon Line -->
                <line class="ccard__horizon" x1="24" y1="110" x2="396" y2="110" stroke-dasharray="2 4" />
                <g class="ccard__reticle" data-reticle>
                  <rect x="168" y="68" width="84" height="84" rx="6" class="ccard__reticle-box" />
                  <path d="M164 78 V64 H178" class="ccard__reticle-corner" />
                  <path d="M256 78 V64 H242" class="ccard__reticle-corner" />
                  <path d="M164 142 V156 H178" class="ccard__reticle-corner" />
                  <path d="M256 142 V156 H242" class="ccard__reticle-corner" />
                </g>
              </svg>
            )}

            <!-- Bottom HUD: apenas a identificação limpa no canto -->
            <div class="ccard__hud-bottom font-mono" aria-hidden="true">
              <span class="ccard__hud-status">
                {idx === 0
                  ? (lang === 'pt' ? 'arquitetura e governança' : 'architecture and governance')
                  : (lang === 'pt' ? 'eficiência e IA aplicada' : 'efficiency and applied AI')}
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="ccard__body">
            <h3 class="ccard__title">{offer.title}</h3>
            <p class="ccard__desc">{offer.cardSummary}</p>

            <!-- Interactive Product Chips (em coluna única alinhada) -->
            <div class="ccard__products" role="list" aria-label={data.solutionsCountLabel}>
              {offer.products.map((prod) => (
                <a
                  href={`${offer.href}#prod-${prod.id}`}
                  class="ccard__chip"
                  role="listitem"
                >
                  <span class="ccard__chip-num font-mono">{prod.num}</span>
                  <span class="ccard__chip-name">{prod.title}</span>
                </a>
              ))}
            </div>

            <!-- Card Footer CTA -->
            <div class="ccard__footer">
              <a href={offer.href} class="ccard__cta">
                <span class="ccard__cta-text">{data.cardCta}</span>
                <span class="ccard__cta-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .consultoria {
    position: relative;
    background:
      radial-gradient(ellipse 60% 45% at 15% 15%, hsl(243 75% 59% / 0.045), transparent 70%),
      radial-gradient(ellipse 55% 45% at 85% 85%, hsl(173 80% 36% / 0.045), transparent 70%),
      var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .consultoria__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .consultoria__title {
    margin-top: 0.75rem;
    max-width: 24ch;
  }
  .consultoria__lead {
    max-width: 54ch;
    align-self: end;
  }

  @media (min-width: 960px) {
    .consultoria__head {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: end;
      gap: 3rem;
    }
  }

  .consultoria__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (min-width: 960px) {
    .consultoria__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ── Ultra-Minimalist Interactive Card ── */
  .ccard {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .ccard::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      520px circle at var(--mx, 50%) var(--my, 25%),
      color-mix(in srgb, var(--card-accent) 7%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
  }

  .ccard:hover {
    border-color: color-mix(in srgb, var(--card-accent) 42%, var(--line));
    box-shadow:
      0 28px 64px -24px hsl(240 24% 9% / 0.10),
      0 0 0 1px color-mix(in srgb, var(--card-accent) 18%, transparent);
    transform: translateY(-4px);
  }
  .ccard:hover::before {
    opacity: 1;
  }

  .ccard__MainLink {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* ── Visual Stage ── */
  .ccard__stage {
    position: relative;
    height: 248px;
    background:
      linear-gradient(180deg, hsl(240 20% 98.5%) 0%, hsl(240 16% 96.5%) 100%);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    z-index: 2;
    cursor: pointer;
  }

  .ccard__stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, hsl(240 10% 12% / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, hsl(240 10% 12% / 0.035) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, #000 35%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, #000 35%, transparent 100%);
  }

  .ccard__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ccard__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Isometric planes micro-animation on Card 01 */
  .ccard__iso-plane {
    fill: color-mix(in srgb, var(--card-accent) 4%, rgba(255, 255, 255, 0.55));
    stroke: color-mix(in srgb, var(--card-accent) 32%, hsl(240 10% 70%));
    stroke-width: 1;
    transition: transform 0.65s var(--ease-out), stroke 0.4s ease, fill 0.4s ease;
    transform-origin: 210px 110px;
  }
  .ccard__iso-axis {
    stroke: color-mix(in srgb, var(--card-accent) 45%, transparent);
    stroke-width: 1;
  }
  .ccard__iso-node {
    fill: var(--bg-elev);
    stroke: var(--card-accent);
    stroke-width: 1.5;
    transition: transform 0.65s var(--ease-out), fill 0.35s ease;
  }

  .ccard:hover .ccard__iso-plane--1 {
    transform: translateY(-10px) scale(1.03);
    stroke: var(--card-accent);
    fill: color-mix(in srgb, var(--card-accent) 9%, rgba(255, 255, 255, 0.72));
  }
  .ccard:hover .ccard__iso-plane--2 {
    transform: scale(1.015);
    stroke: color-mix(in srgb, var(--card-accent) 65%, hsl(240 10% 60%));
  }
  .ccard:hover .ccard__iso-plane--3 {
    transform: translateY(10px) scale(1.03);
    stroke: var(--card-accent);
    fill: color-mix(in srgb, var(--card-accent) 7%, rgba(255, 255, 255, 0.65));
  }
  .ccard:hover .ccard__iso-node--top {
    transform: translateY(-10px);
    fill: var(--card-accent);
  }
  .ccard:hover .ccard__iso-node--bot {
    transform: translateY(10px);
    fill: var(--card-accent);
  }

  /* Reticle micro-animation on Card 02 */
  .ccard__horizon {
    stroke: color-mix(in srgb, var(--card-accent) 30%, hsl(240 10% 75%));
    stroke-width: 1;
  }
  .ccard__reticle {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: 210px 110px;
  }
  .ccard__reticle-box {
    stroke: color-mix(in srgb, var(--card-accent) 26%, transparent);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    fill: color-mix(in srgb, var(--card-accent) 3%, transparent);
    transition: stroke 0.35s ease, fill 0.35s ease;
  }
  .ccard__reticle-corner {
    stroke: var(--card-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.55;
    transition: opacity 0.35s ease;
  }
  .ccard:hover .ccard__reticle-box {
    stroke: color-mix(in srgb, var(--card-accent) 55%, transparent);
    fill: color-mix(in srgb, var(--card-accent) 6%, transparent);
  }
  .ccard:hover .ccard__reticle-corner {
    opacity: 1;
  }

  /* Stage HUD bars */
  .ccard__hud-top,
  .ccard__hud-bottom {
    position: absolute;
    left: 1.15rem;
    right: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    pointer-events: none;
    z-index: 3;
  }
  .ccard__hud-top { top: 0.9rem; }
  .ccard__hud-bottom { bottom: 0.85rem; }

  .ccard__hud-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.22rem 0.55rem;
    border-radius: var(--radius-pill);
    background: hsl(0 0% 100% / 0.85);
    border: 1px solid var(--line);
    color: var(--ink-2);
    backdrop-filter: blur(6px);
  }
  .ccard__hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--card-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--card-accent) 20%, transparent);
    transition: transform 0.3s ease;
  }
  .ccard:hover .ccard__hud-dot {
    transform: scale(1.25);
  }

  .ccard__hud-coord {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: hsl(0 0% 100% / 0.75);
    border: 1px solid var(--line);
    color: var(--card-accent);
    font-weight: 600;
  }

  .ccard__hud-status {
    color: var(--ink-2);
    font-weight: 500;
    transition: color 0.25s ease;
  }
  .ccard:hover .ccard__hud-status {
    color: var(--card-accent);
  }

  /* ── Card Body ── */
  .ccard__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    pointer-events: none;
  }

  .ccard__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.9rem;
  }
  .ccard__num {
    display: inline-grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--card-accent);
    background: color-mix(in srgb, var(--card-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--card-accent) 24%, transparent);
  }
  .ccard__axis {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ccard__title {
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 0.85rem;
    transition: color 0.25s ease;
  }

  .ccard__desc {
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }

  /* ── Product Micro-Pills (Coluna única alinhada) ── */
  .ccard__products {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.85rem;
    pointer-events: auto;
  }

  .ccard__chip {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-xs);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink-2);
    transition:
      background-color 0.22s ease,
      border-color 0.22s ease,
      color 0.22s ease,
      transform 0.22s var(--ease-out);
  }
  .ccard__chip-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--card-accent);
    min-width: 1.8rem;
  }
  .ccard__chip-name {
    font-weight: 500;
  }
      transform 0.22s var(--ease-out);
  }
  .ccard__chip-num {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--card-accent);
  }
  .ccard__chip-name {
    font-weight: 500;
  }
  .ccard__chip:hover {
    background: color-mix(in srgb, var(--card-accent) 8%, var(--bg-elev));
    border-color: color-mix(in srgb, var(--card-accent) 40%, var(--line));
    color: var(--ink);
    transform: translateY(-2px);
  }

  /* ── Footer CTA ── */
  .ccard__footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    pointer-events: auto;
  }

  .ccard__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink);
    transition: color 0.25s ease;
  }
  .ccard__cta-icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--bg-elev);
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .ccard:hover .ccard__cta {
    color: var(--card-accent);
  }
  .ccard:hover .ccard__cta-icon {
    background: var(--card-accent);
    border-color: var(--card-accent);
    color: #fff;
    transform: translateX(4px);
  }
</style>

<script>
  function initConsultoriaCards() {
    const cards = document.querySelectorAll<HTMLElement>('[data-consultoria-card]');
    if (!cards.length) return;

    cards.forEach((card) => {
      const kind = card.dataset.consultoriaCard;
      const canvas = card.querySelector<HTMLCanvasElement>('[data-card-canvas]');
      const stage = card.querySelector<HTMLElement>('[data-stage]');
      const reticle = card.querySelector<SVGGElement>('[data-reticle]');

      // Stage click navigates to offer href
      const mainLink = card.querySelector<HTMLAnchorElement>('.ccard__MainLink');
      stage?.addEventListener('click', () => {
        if (mainLink?.href) window.location.href = mainLink.href;
      });

      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let width = 0;
      let height = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let hovered = false;
      let mx = 0.5;
      let my = 0.5;
      let tx = 0.5;
      let ty = 0.5;
      let rafId = 0;
      let isVisible = false;

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener('resize', resize, { passive: true });

      card.addEventListener('pointerenter', () => {
        hovered = true;
      });
      card.addEventListener('pointerleave', () => {
        hovered = false;
        tx = 0.5;
        ty = 0.5;
        if (reticle) {
          reticle.style.transform = 'translate3d(0px, 0px, 0px)';
        }
      });
      card.addEventListener('pointermove', (e) => {
        const cardRect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - cardRect.left}px`);
        card.style.setProperty('--my', `${e.clientY - cardRect.top}px`);

        const rect = canvas.getBoundingClientRect();
        tx = Math.max(0.08, Math.min(0.92, (e.clientX - rect.left) / Math.max(1, rect.width)));
        ty = Math.max(0.14, Math.min(0.86, (e.clientY - rect.top) / Math.max(1, rect.height)));

        if (reticle) {
          const dx = (tx - 0.5) * 140;
          const dy = (ty - 0.5) * 65;
          reticle.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
        }
      });

      // Nodes for Card 01 (Complexity -> Structured Governance Matrix)
      const nodes = Array.from({ length: 24 }, (_, i) => {
        const col = i % 6;
        const row = Math.floor(i / 6);
        return {
          // Scattered organic state
          sx: 0.12 + ((i * 37) % 76) / 100,
          sy: 0.18 + ((i * 53) % 64) / 100,
          // Structured governance grid state
          gx: 0.18 + (col / 5) * 0.64,
          gy: 0.24 + (row / 3) * 0.52,
          phase: i * 0.45,
          r: i % 3 === 0 ? 2.6 : 1.8,
        };
      });

      let t = 0;
      let orderFactor = 0;

      const render = () => {
        if (!isVisible) return;
        t += 0.018;
        mx += (tx - mx) * 0.12;
        my += (ty - my) * 0.12;
        orderFactor += ((hovered ? 1 : 0) - orderFactor) * 0.08;

        ctx.clearRect(0, 0, width, height);

        if (kind === 'complexity') {
          const cx = mx * width;
          const cy = my * height;

          // Compute current node positions interpolating between organic drift and structured governance grid
          const pts = nodes.map((n) => {
            const driftX = Math.sin(t + n.phase) * 0.022 * (1 - orderFactor * 0.7);
            const driftY = Math.cos(t * 0.9 + n.phase) * 0.022 * (1 - orderFactor * 0.7);
            const x = (n.sx + (n.gx - n.sx) * orderFactor + driftX) * width;
            const y = (n.sy + (n.gy - n.sy) * orderFactor + driftY) * height;
            return { x, y, r: n.r };
          });

          // Draw subtle network edges
          ctx.lineWidth = 1;
          for (let i = 0; i < pts.length; i++) {
            for (let j = i + 1; j < pts.length; j++) {
              const dx = pts[i].x - pts[j].x;
              const dy = pts[i].y - pts[j].y;
              const dist = Math.hypot(dx, dy);
              const maxDist = 78 + orderFactor * 28;
              if (dist < maxDist) {
                const alpha = (1 - dist / maxDist) * (0.12 + orderFactor * 0.18);
                ctx.strokeStyle = `rgba(79, 70, 229, ${alpha.toFixed(3)})`;
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.stroke();
              }
            }
          }

          // Draw nodes & cursor alignment vectors
          pts.forEach((p) => {
            const dCursor = Math.hypot(p.x - cx, p.y - cy);
            if (hovered && dCursor < 130) {
              const a = (1 - dCursor / 130) * 0.32;
              ctx.strokeStyle = `rgba(79, 70, 229, ${a.toFixed(3)})`;
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(cx, cy);
              ctx.stroke();
            }

            ctx.fillStyle = dCursor < 110 && hovered ? '#4F46E5' : 'rgba(79, 70, 229, 0.55)';
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r + (hovered && dCursor < 90 ? 1 : 0), 0, Math.PI * 2);
            ctx.fill();
          });
        } else {
          // Card 02: Operational Efficiency & Applied Intelligence (Signal bars + harmonic wave)
          const bars = 38;
          const padX = 28;
          const usableW = Math.max(10, width - padX * 2);
          const step = usableW / (bars - 1);
          const midY = height * 0.52;
          const focusX = mx * width;

          // Draw vertical telemetry bars
          for (let i = 0; i < bars; i++) {
            const x = padX + i * step;
            const distFromFocus = Math.abs(x - focusX) / (width * 0.35);
            const focusBoost = Math.max(0, 1 - distFromFocus);
            const wave =
              Math.sin(i * 0.32 + t * 1.7) * 14 +
              Math.cos(i * 0.19 - t * 1.2) * 10;
            const barHalf =
              10 +
              Math.abs(wave) * (0.65 + orderFactor * 0.35) +
              focusBoost * (18 + orderFactor * 22);

            const alpha = 0.16 + focusBoost * (0.45 + orderFactor * 0.3);
            ctx.strokeStyle = `rgba(13, 148, 136, ${alpha.toFixed(3)})`;
            ctx.lineWidth = focusBoost > 0.55 ? 2.2 : 1.4;
            ctx.beginPath();
            ctx.moveTo(x, midY - barHalf);
            ctx.lineTo(x, midY + barHalf);
            ctx.stroke();

            // Peak dot on top of active bars
            if (focusBoost > 0.45) {
              ctx.fillStyle = '#0D9488';
              ctx.beginPath();
              ctx.arc(x, midY - barHalf - 4, 1.8, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          // Continuous AI prediction spline across stage
          ctx.strokeStyle = `rgba(13, 148, 136, ${(0.45 + orderFactor * 0.4).toFixed(2)})`;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          for (let x = padX; x <= width - padX; x += 6) {
            const norm = (x - focusX) / 90;
            const env = Math.exp(-norm * norm * 0.5);
            const y =
              midY +
              Math.sin(x * 0.035 - t * 2.2) * (12 + env * 22 * (0.5 + orderFactor * 0.5));
            if (x === padX) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        }

        rafId = requestAnimationFrame(render);
      };

      const io = new IntersectionObserver(
        ([entry]) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(render);
          } else {
            cancelAnimationFrame(rafId);
          }
        },
        { threshold: 0.05 }
      );
      io.observe(card);
    });
  }

  initConsultoriaCards();
</script>

