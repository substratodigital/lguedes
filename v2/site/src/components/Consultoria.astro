  .tcard__ia-box {
    background: color-mix(in srgb, var(--t-accent) 6%, var(--bg-soft));
    border: 1px solid color-mix(in srgb, var(--t-accent) 24%, var(--line));
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
  }
  .tcard__ia-badge {
    display: inline-flex;
