    justify-content: space-between;
    gap: 0.75rem;
  }
  .tcard__icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--t-accent) 10%, transparent);
