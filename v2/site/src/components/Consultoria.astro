  }
  .tcard__list :global(.tcard__check) {
    color: var(--t-accent);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* ── Formas de Intervenção — Radar contínuo ── */
  .radar-block {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .radar-block__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .radar-block__head {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 2.5rem;
    }
  }
  .radar-block__sub {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .radar {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .radar { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); }
  }
  .radar__stage {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
  }
  .radar__scope {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    border-radius: 50%;
  }
  .radar__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .radar__ring {
    fill: none;
    stroke: hsl(243 40% 70% / 0.32);
    stroke-width: 1;
  }
  .radar__ring--3 { stroke: hsl(243 50% 60% / 0.45); }
  .radar__core {
    fill: hsl(243 90% 97%);
    stroke: hsl(243 75% 59% / 0.35);
    stroke-width: 1;
  }
  .radar__axis { stroke: hsl(243 30% 70% / 0.22); stroke-width: 1; stroke-dasharray: 2 5; }
  .radar__axis--diag { stroke: hsl(243 30% 70% / 0.14); }
  .radar__noise { fill: hsl(243 60% 60% / 0.28); }
  .radar__ring-label {
    font-family: var(--font-mono);
    font-size: 6.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--ink-3);
  }

  .radar__sweep {
    position: absolute;
    inset: 2%;
    border-radius: 50%;
    pointer-events: none;
    background: conic-gradient(
      from 0deg,
      hsl(243 75% 59% / 0) 0deg,
      hsl(243 75% 59% / 0) 290deg,
      hsl(243 75% 59% / 0.05) 320deg,
      hsl(243 75% 59% / 0.2) 360deg
    );
    will-change: transform;
  }
  .radar__sweep i {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 50%;
    transform: translateX(-50%);
    background: linear-gradient(to top, hsl(243 75% 59% / 0.15), hsl(243 75% 59% / 0.85));
  }

  .radar__blip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    z-index: 3;
    -webkit-tap-highlight-color: transparent;
  }
  .radar__blip-dot {
    position: relative;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--primary);
    transition: transform 0.35s var(--ease-out), background-color 0.3s;
  }
  .radar__blip-dot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1.5px solid var(--primary);
    opacity: 0;
  }
  .radar__blip.is-ping .radar__blip-dot::after { animation: radarPing 1.4s var(--ease-out); }
  .radar__blip.is-active .radar__blip-dot {
    background: var(--primary);
    transform: scale(1.35);
    box-shadow: 0 0 0 6px hsl(243 75% 59% / 0.14);
  }
  .radar__blip:focus-visible { outline: none; }
  .radar__blip:focus-visible .radar__blip-dot { outline: 2px solid var(--primary); outline-offset: 4px; }
  .radar__blip--core .radar__blip-dot { width: 16px; height: 16px; }
  @keyframes radarPing {
    0% { opacity: 0.9; transform: scale(1); }
    100% { opacity: 0; transform: scale(3.6); }
  }

  .radar__blip-label {
    position: absolute;
    left: calc(50% + 14px);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-2);
    background: hsl(0 0% 100% / 0.82);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    pointer-events: none;
    transition: opacity 0.25s, color 0.25s;
  }
  .radar__blip-label.is-left { left: auto; right: calc(50% + 14px); }
  .radar__blip--core .radar__blip-label { left: 50%; top: calc(50% + 18px); transform: translateX(-50%); }
  .radar__blip.is-active .radar__blip-label { opacity: 0; }

  /* Popup do ponto ativo */
  .radar__pop {
    position: absolute;
    left: var(--px, 50%);
    top: var(--py, 50%);
    z-index: 5;
    width: min(270px, 70%);
    padding: 0.9rem 1rem 1rem;
    border-radius: var(--radius);
    background: hsl(0 0% 100% / 0.94);
    border: 1px solid hsl(243 75% 59% / 0.28);
    box-shadow: 0 18px 44px -18px hsl(243 50% 30% / 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
    --tx: 0px;
    --ty: 26px;
    transform: translate(var(--tx), var(--ty));
  }
  .radar__pop[data-vside='up'] { --ty: calc(-100% - 26px); }
  .radar__pop.is-in { animation: radarPop 0.45s var(--ease-out); }
  @keyframes radarPop {
    from { opacity: 0; transform: translate(var(--tx), calc(var(--ty) + 8px)) scale(0.96); }
    to { opacity: 1; transform: translate(var(--tx), var(--ty)) scale(1); }
  }
  .radar__pop-phase {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 0.3rem;
  }
  .radar__pop-title {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.3rem;
    line-height: 1.25;
  }
  .radar__pop-desc { font-size: 0.82rem; line-height: 1.5; color: var(--ink-2); }

  /* Painel lateral */
  .radar__side { display: flex; flex-direction: column; gap: 1.75rem; min-width: 0; }
  .radar__group { display: flex; flex-direction: column; gap: 0.75rem; }
  .radar__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .radar__steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .radar__steps::before {
    content: '';
    position: absolute;
    left: 0.95rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 1px;
    background: linear-gradient(var(--primary), hsl(243 75% 59% / 0.15));
  }
  .radar__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    background: none;
    border: 1px solid transparent;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .radar__step-dot {
    position: relative;
    z-index: 1;
    width: 0.7rem;
    height: 0.7rem;
    margin-left: 0.05rem;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid hsl(243 75% 59% / 0.5);
    flex-shrink: 0;
    transition: background-color 0.25s, border-color 0.25s, transform 0.3s var(--ease-out);
  }
  .radar__step:hover { color: var(--ink); background: var(--bg-soft); }
  .radar__step.is-active {
    color: var(--primary);
    background: var(--primary-soft);
    border-color: hsl(243 75% 59% / 0.22);
  }
  .radar__step.is-active .radar__step-dot { background: var(--primary); border-color: var(--primary); transform: scale(1.2); }

  .radar__phases { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .radar__phases li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .radar__phase-ring {
    width: calc(0.5rem + var(--ring) * 0.18rem);
    height: calc(0.5rem + var(--ring) * 0.18rem);
    border-radius: 50%;
    border: 1.5px solid hsl(243 60% 60% / calc(0.45 + var(--ring) * 0.15));
  }
  .radar__hint { font-size: 0.8rem; line-height: 1.5; color: var(--ink-3); }
  .radar__cta { align-self: flex-start; min-width: 280px; }

  @media (max-width: 959px) {
    .radar__stage { max-width: 440px; }
    .radar__blip-label { display: none; }
    /* popup vira um cartão fixo abaixo do radar (sem sobrepor no toque) */
    .radar__pop {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      margin-top: 1rem;
      min-height: 8.5rem;
      --tx: 0px;
      --ty: 0px;
      transform: none;
    }
    .radar__pop[data-vside='up'] { --tx: 0px; --ty: 0px; }
    .radar__group--phases .radar__hint { display: none; }
    .radar__steps {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      gap: 0.4rem;
      padding-bottom: 0.25rem;
      margin-inline: -0.25rem;
      scrollbar-width: none;
    }
    .radar__steps::-webkit-scrollbar { display: none; }
    .radar__steps::before { display: none; }
    .radar__step {
      flex-shrink: 0;
      scroll-snap-align: start;
      white-space: nowrap;
      font-size: 0.8rem;
      padding: 0.45rem 0.8rem;
      border-color: var(--line);
      border-radius: var(--radius-pill);
    }
    .radar__step-dot { display: none; }
    .radar__cta { width: 100%; min-width: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .radar__sweep { opacity: 0.6; }
    .radar__blip.is-ping .radar__blip-dot::after, .radar__pop.is-in { animation: none; }
  }

  /* ── 3 Cases Selecionados (motion + carrossel 3D no mobile) ── */
  .cases-block {
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
  }
  .cases-block__head {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 900px) {
    .cases-block__head {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 2.5rem;
    }
  }
  .cases-block__sub {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .cases__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .cases__dots { display: none; }

  .case-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.4s var(--ease-out), border-color 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  @media (hover: hover) and (min-width: 1024px) {
    .case-card:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--c-accent) 40%, var(--line));
      box-shadow: 0 28px 64px -24px hsl(240 24% 9% / 0.14);
    }
  }
  .case-card__stage {
    position: relative;
    height: 190px;
    background: linear-gradient(180deg, hsl(240 20% 98.5%) 0%, hsl(240 16% 96.5%) 100%);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    touch-action: pan-x pan-y;
  }
  .case-card__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, hsl(240 10% 12% / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, hsl(240 10% 12% / 0.035) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, #000 35%, transparent 100%);
  }
  .case-card__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .case-card__hud {
    position: absolute;
    left: 1rem;
    bottom: 0.7rem;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    pointer-events: none;
    transition: color 0.3s;
  }
  .case-card:hover .case-card__hud, .case-card.is-active .case-card__hud { color: var(--c-accent); }
  .case-card__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 1.6rem 1.6rem;
    flex: 1;
  }
  .case-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .case-card__territory {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .case-card__sector {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .case-card__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .case-card__label {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .case-card__text {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .case-card__item--result {
    background: color-mix(in srgb, var(--c-accent) 6%, var(--bg-soft));
    border-left: 3px solid var(--c-accent);
    padding: 0.75rem 0.9rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .case-card__item--result .case-card__label { color: var(--c-accent); }
  .case-card__item--result .case-card__text { color: var(--ink); font-weight: 500; }
  .case-card__quote {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line);
    font-size: 0.82rem;
    font-style: italic;
    color: var(--ink-3);
    line-height: 1.5;
  }

  /* Carrossel coverflow: card central ampliado, laterais em perspectiva */
  @media (max-width: 1023px) {
    .cases__viewport { margin-inline: calc(var(--gutter) * -1); }
    .cases__track {
      display: flex;
      gap: 0;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 1rem calc((100% - min(74vw, 400px)) / 2) 1.5rem;
      overscroll-behavior-x: contain;
    }
    .cases__track::-webkit-scrollbar { display: none; }
    .case-card {
      flex: 0 0 min(74vw, 400px);
      scroll-snap-align: center;
      margin-inline: -2.5vw;
      transform-origin: center center;
      will-change: transform, opacity;
      transition: box-shadow 0.4s var(--ease-out), border-color 0.4s;
    }
    .case-card.is-active {
      border-color: color-mix(in srgb, var(--c-accent) 38%, var(--line));
      box-shadow: 0 30px 60px -28px hsl(243 40% 20% / 0.3);
    }
    .case-card__stage { height: 170px; }
    .case-card__body { padding: 1.25rem 1.25rem 1.4rem; }
    .cases__dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.25rem;
    }
    .cases__dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: var(--line-strong);
      cursor: pointer;
      transition: width 0.35s var(--ease-out), background-color 0.3s;
      position: relative;
    }
    .cases__dot::before { content: ''; position: absolute; inset: -12px -6px; }
    .cases__dot.is-active { width: 26px; background: var(--primary); }
  }

  /* ── Subheader do Portfólio ── */
  .portfolio-subheader {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .consultoria__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (min-width: 960px) {
    .consultoria__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ── Ultra-Minimalist Interactive Card ── */
  .ccard {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .ccard::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      520px circle at var(--mx, 50%) var(--my, 25%),
      color-mix(in srgb, var(--card-accent) 7%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
  }

  .ccard:hover {
    border-color: color-mix(in srgb, var(--card-accent) 42%, var(--line));
    box-shadow:
      0 28px 64px -24px hsl(240 24% 9% / 0.10),
      0 0 0 1px color-mix(in srgb, var(--card-accent) 18%, transparent);
    transform: translateY(-4px);
  }
  .ccard:hover::before {
    opacity: 1;
  }

  .ccard__MainLink {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* ── Visual Stage ── */
  .ccard__stage {
    position: relative;
    height: 248px;
    background:
      linear-gradient(180deg, hsl(240 20% 98.5%) 0%, hsl(240 16% 96.5%) 100%);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    z-index: 2;
    cursor: pointer;
  }

  .ccard__stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, hsl(240 10% 12% / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, hsl(240 10% 12% / 0.035) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, #000 35%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, #000 35%, transparent 100%);
  }

  .ccard__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ccard__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Isometric planes micro-animation on Card 01 */
  .ccard__iso-plane {
    fill: color-mix(in srgb, var(--card-accent) 4%, rgba(255, 255, 255, 0.55));
    stroke: color-mix(in srgb, var(--card-accent) 32%, hsl(240 10% 70%));
    stroke-width: 1;
    transition: transform 0.65s var(--ease-out), stroke 0.4s ease, fill 0.4s ease;
    transform-origin: 210px 110px;
  }
  .ccard__iso-axis {
    stroke: color-mix(in srgb, var(--card-accent) 45%, transparent);
    stroke-width: 1;
  }
  .ccard__iso-node {
    fill: var(--surface);
    stroke: var(--card-accent);
    stroke-width: 1.5;
    transition: transform 0.65s var(--ease-out), fill 0.35s ease;
  }

  .ccard:hover .ccard__iso-plane--1 {
    transform: translateY(-10px) scale(1.03);
    stroke: var(--card-accent);
    fill: color-mix(in srgb, var(--card-accent) 9%, rgba(255, 255, 255, 0.72));
  }
  .ccard:hover .ccard__iso-plane--2 {
    transform: scale(1.015);
    stroke: color-mix(in srgb, var(--card-accent) 65%, hsl(240 10% 60%));
  }
  .ccard:hover .ccard__iso-plane--3 {
    transform: translateY(10px) scale(1.03);
    stroke: var(--card-accent);
    fill: color-mix(in srgb, var(--card-accent) 7%, rgba(255, 255, 255, 0.65));
  }
  .ccard:hover .ccard__iso-node--top {
    transform: translateY(-10px);
    fill: var(--card-accent);
  }
  .ccard:hover .ccard__iso-node--bot {
    transform: translateY(10px);
    fill: var(--card-accent);
  }

  /* Reticle micro-animation on Card 02 */
  .ccard__horizon {
    stroke: color-mix(in srgb, var(--card-accent) 30%, hsl(240 10% 75%));
    stroke-width: 1;
  }
  .ccard__reticle {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: 210px 110px;
  }
  .ccard__reticle-box {
    stroke: color-mix(in srgb, var(--card-accent) 26%, transparent);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    fill: color-mix(in srgb, var(--card-accent) 3%, transparent);
    transition: stroke 0.35s ease, fill 0.35s ease;
  }
  .ccard__reticle-corner {
    stroke: var(--card-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.55;
    transition: opacity 0.35s ease;
  }
  .ccard:hover .ccard__reticle-box {
    stroke: color-mix(in srgb, var(--card-accent) 55%, transparent);
    fill: color-mix(in srgb, var(--card-accent) 6%, transparent);
  }
  .ccard:hover .ccard__reticle-corner {
    opacity: 1;
  }

  /* Stage HUD bars */
  .ccard__hud-bottom {
    position: absolute;
    left: 1.15rem;
    right: 1.15rem;
    bottom: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    pointer-events: none;
    z-index: 3;
  }

  .ccard__hud-status {
    color: var(--ink-2);
    font-weight: 500;
    transition: color 0.25s ease;
  }
  .ccard:hover .ccard__hud-status {
    color: var(--card-accent);
  }

  /* ── Card Body ── */
  .ccard__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    pointer-events: none;
  }

  .ccard__title {
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 0.85rem;
    transition: color 0.25s ease;
  }

  .ccard__desc {
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }

  /* ── Product Micro-Pills (Coluna única alinhada) ── */
  .ccard__products {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.85rem;
    pointer-events: auto;
  }

  .ccard__chip {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink-2);
    transition:
      background-color 0.22s ease,
      border-color 0.22s ease,
      color 0.22s ease,
      transform 0.22s var(--ease-out);
  }
  .ccard__chip-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--card-accent);
    min-width: 1.8rem;
  }
  .ccard__chip-name {
    font-weight: 500;
  }
  .ccard__chip:hover {
    background: color-mix(in srgb, var(--card-accent) 8%, var(--surface));
    border-color: color-mix(in srgb, var(--card-accent) 40%, var(--line));
    color: var(--ink);
    transform: translateY(-2px);
  }

  /* ── Footer CTA ── */
  .ccard__footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    pointer-events: auto;
  }

  .ccard__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink);
    transition: color 0.25s ease;
  }
  .ccard__cta-icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .ccard:hover .ccard__cta {
    color: var(--card-accent);
  }
  .ccard:hover .ccard__cta-icon {
    background: var(--card-accent);
    border-color: var(--card-accent);
    color: #fff;
    transform: translateX(4px);
  }
</style>

<script>
  import { initRadar } from '../scripts/radar';
  import { initCasesMotion, initCasesCarousel } from '../scripts/cases-motion';

  initRadar();
  initCasesMotion();
  initCasesCarousel();

  function initConsultoriaCards() {
    const cards = document.querySelectorAll<HTMLElement>('[data-consultoria-card]');
    if (!cards.length) return;

    cards.forEach((card) => {
      const kind = card.dataset.consultoriaCard;
      const canvas = card.querySelector<HTMLCanvasElement>('[data-card-canvas]');
      const stage = card.querySelector<HTMLElement>('[data-stage]');
      const reticle = card.querySelector<SVGGElement>('[data-reticle]');

      const mainLink = card.querySelector<HTMLAnchorElement>('.ccard__MainLink');
      stage?.addEventListener('click', () => {
        if (mainLink?.href) window.location.href = mainLink.href;
      });

      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let width = 0;
      let height = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let hovered = false;
      let mx = 0.5;
      let my = 0.5;
      let tx = 0.5;
      let ty = 0.5;
      let rafId = 0;
      let isVisible = false;

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener('resize', resize, { passive: true });

      card.addEventListener('pointerenter', () => {
        hovered = true;
      });
      card.addEventListener('pointerleave', () => {
        hovered = false;
        tx = 0.5;
        ty = 0.5;
        if (reticle) {
          reticle.style.transform = 'translate3d(0px, 0px, 0px)';
        }
      });
      card.addEventListener('pointermove', (e) => {
        const cardRect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - cardRect.left}px`);
        card.style.setProperty('--my', `${e.clientY - cardRect.top}px`);

        const rect = canvas.getBoundingClientRect();
        tx = Math.max(0.08, Math.min(0.92, (e.clientX - rect.left) / Math.max(1, rect.width)));
        ty = Math.max(0.14, Math.min(0.86, (e.clientY - rect.top) / Math.max(1, rect.height)));

        if (reticle) {
          const dx = (tx - 0.5) * 140;
          const dy = (ty - 0.5) * 65;
          reticle.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
        }
      });

      const nodes = Array.from({ length: 24 }, (_, i) => {
        const col = i % 6;
        const row = Math.floor(i / 6);
        return {
          sx: 0.12 + ((i * 37) % 76) / 100,
          sy: 0.18 + ((i * 53) % 64) / 100,
          gx: 0.18 + (col / 5) * 0.64,
          gy: 0.24 + (row / 3) * 0.52,
          phase: i * 0.45,
          r: i % 3 === 0 ? 2.6 : 1.8,
        };
      });

      let t = 0;
      let orderFactor = 0;

      const render = () => {
        if (!isVisible) return;
        t += 0.018;
        mx += (tx - mx) * 0.12;
        my += (ty - my) * 0.12;
        orderFactor += ((hovered ? 1 : 0) - orderFactor) * 0.08;

        ctx.clearRect(0, 0, width, height);

        if (kind === 'complexity') {
          const cx = mx * width;
          const cy = my * height;

          const pts = nodes.map((n) => {
            const driftX = Math.sin(t + n.phase) * 0.022 * (1 - orderFactor * 0.7);
            const driftY = Math.cos(t * 0.9 + n.phase) * 0.022 * (1 - orderFactor * 0.7);
            const x = (n.sx + (n.gx - n.sx) * orderFactor + driftX) * width;
            const y = (n.sy + (n.gy - n.sy) * orderFactor + driftY) * height;
            return { x, y, r: n.r };
          });

          ctx.lineWidth = 1;
          for (let i = 0; i < pts.length; i++) {
            for (let j = i + 1; j < pts.length; j++) {
              const dx = pts[i].x - pts[j].x;
              const dy = pts[i].y - pts[j].y;
              const dist = Math.hypot(dx, dy);
              const maxDist = 78 + orderFactor * 28;
              if (dist < maxDist) {
                const alpha = (1 - dist / maxDist) * (0.12 + orderFactor * 0.18);
                ctx.strokeStyle = `rgba(79, 70, 229, ${alpha.toFixed(3)})`;
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.stroke();
              }
            }
          }

          pts.forEach((p) => {
            const dCursor = Math.hypot(p.x - cx, p.y - cy);
            if (hovered && dCursor < 130) {
              const a = (1 - dCursor / 130) * 0.32;
              ctx.strokeStyle = `rgba(79, 70, 229, ${a.toFixed(3)})`;
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(cx, cy);
              ctx.stroke();
            }

            ctx.fillStyle = dCursor < 110 && hovered ? '#4F46E5' : 'rgba(79, 70, 229, 0.55)';
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r + (hovered && dCursor < 90 ? 1 : 0), 0, Math.PI * 2);
            ctx.fill();
          });
        } else {
          const bars = 38;
          const padX = 28;
          const usableW = Math.max(10, width - padX * 2);
          const step = usableW / (bars - 1);
          const midY = height * 0.52;
          const focusX = mx * width;

          for (let i = 0; i < bars; i++) {
            const x = padX + i * step;
            const distFromFocus = Math.abs(x - focusX) / (width * 0.35);
            const focusBoost = Math.max(0, 1 - distFromFocus);
            const wave =
              Math.sin(i * 0.32 + t * 1.7) * 14 +
              Math.cos(i * 0.19 - t * 1.2) * 10;
            const barHalf =
              10 +
              Math.abs(wave) * (0.65 + orderFactor * 0.35) +
              focusBoost * (18 + orderFactor * 22);

            const alpha = 0.16 + focusBoost * (0.45 + orderFactor * 0.3);
            ctx.strokeStyle = `rgba(13, 148, 136, ${alpha.toFixed(3)})`;
            ctx.lineWidth = focusBoost > 0.55 ? 2.2 : 1.4;
            ctx.beginPath();
            ctx.moveTo(x, midY - barHalf);
            ctx.lineTo(x, midY + barHalf);
            ctx.stroke();

            if (focusBoost > 0.45) {
              ctx.fillStyle = '#0D9488';
              ctx.beginPath();
              ctx.arc(x, midY - barHalf - 4, 1.8, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          ctx.strokeStyle = `rgba(13, 148, 136, ${(0.45 + orderFactor * 0.4).toFixed(2)})`;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          for (let x = padX; x <= width - padX; x += 6) {
            const norm = (x - focusX) / 90;
            const env = Math.exp(-norm * norm * 0.5);
            const y =
              midY +
              Math.sin(x * 0.035 - t * 2.2) * (12 + env * 22 * (0.5 + orderFactor * 0.5));
            if (x === padX) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        }

        rafId = requestAnimationFrame(render);
      };

      const io = new IntersectionObserver(
        ([entry]) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(render);
          } else {
            cancelAnimationFrame(rafId);
          }
        },
        { threshold: 0.05 }
      );
      io.observe(card);
    });
  }

  initConsultoriaCards();
</script>
